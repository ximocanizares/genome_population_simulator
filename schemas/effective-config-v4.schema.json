{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effective-config-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["effective_config_kind", "schema_version", "source_path", "ploidy", "normalization", "seed", "reference", "reduced_references", "authorizations", "initial_populations"],
  "properties": {
    "effective_config_kind": {"const": "gps_effective_config"},
    "schema_version": {"const": "4"},
    "source_path": {"type": "string", "minLength": 1},
    "ploidy": {"type": "integer", "minimum": 1, "maximum": 10},
    "normalization": {
      "type": "object", "additionalProperties": false,
      "required": ["tolerance", "canonical_order", "sum_algorithm"],
      "properties": {
        "tolerance": {"type": "number", "minimum": 0, "maximum": 0.000001},
        "canonical_order": {"const": "population_id,contig,position,ref,alt,variant_id,source_id"},
        "sum_algorithm": {"const": "neumaier_sum_v1"}
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "origin"],
      "properties": {
        "root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "origin": {"enum": ["declared", "system_csprng"]}
      }
    },
    "reference": {"$ref": "#/$defs/reference"},
    "authorizations": {"$ref": "#/$defs/authorizations"},
    "initial_populations": {"type": "array", "items": {"$ref": "#/$defs/initial_population"}},
    "direct_events": {"type": "array", "items": {"$ref": "#/$defs/direct_event"}},
    "technical_event": {"$ref": "#/$defs/technical_event"},
    "vcf_output": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["text", "bgzf"]}}}
      ]
    },
    "population_snvs": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
          "required": ["mode", "metadata_sha256", "normalization_audit"],
          "properties": {
            "mode": {"enum": ["supplied", "generated", "reuse"]},
            "metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "metadata_artifact_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
            "normalization_audit": {"$ref": "#/$defs/normalization_audit"},
            "initial_population_statistics": {"$ref": "#/$defs/initial_population_statistics"}
          },
          "allOf": [
            {"if": {"properties": {"mode": {"const": "reuse"}}, "required": ["mode"]}, "then": {"properties": {"metadata_artifact_id": {"type": "null"}}}},
            {"if": {"properties": {"mode": {"enum": ["supplied", "generated"]}}, "required": ["mode"]}, "then": {"required": ["metadata_artifact_id"], "properties": {"metadata_artifact_id": {"type": "string", "minLength": 1}}}}
          ]}
      ]
    },
    "reduced_references": {"type": "array", "items": {"$ref": "#/$defs/reduction"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reference": {
            "properties": {"source": {"const": "simulated"}},
            "required": ["source"]
          }
        },
        "required": ["reference"]
      },
      "then": {"properties": {"reduced_references": {"maxItems": 0}}}
    },
    {
      "if": {
        "properties": {"initial_populations": {"minItems": 1}},
        "required": ["initial_populations"]
      },
      "then": {
        "required": ["population_snvs"],
        "properties": {
          "population_snvs": {
            "type": "object",
            "required": ["initial_population_statistics"]
          }
        }
      }
    }
  ],
  "$defs": {
    "initial_population_statistics": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "version", "provenance", "populations"],
      "properties": {
        "kind": {"const": "initial_population_statistics"},
        "version": {"const": "1"},
        "provenance": {"$ref": "#/$defs/initial_population_statistics_provenance"},
        "populations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/initial_population_statistics_population"}}
      }
    },
    "initial_population_statistics_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["matrix_reference_id", "matrix_reference_fingerprint", "matrix_canonical_tsv_sha256", "genotype_algorithms", "missing_locus_policy", "explicit_snp_constraints"],
      "properties": {
        "matrix_reference_id": {"type": "string", "minLength": 1},
        "matrix_reference_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "matrix_canonical_tsv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "genotype_algorithms": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"const": "hwe-composition-v1"}, {"const": "f-diploid-genotype-v1"}, {"const": "phase-permutation-v1"}], "items": false},
        "missing_locus_policy": {"const": "missing_by_deletion_excluded_from_allele_frequency_denominator_v1"},
        "explicit_snp_constraints": {"type": "array", "items": {"$ref": "#/$defs/explicit_snp_constraint"}}
      }
    },
    "explicit_snp_constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["population_id", "individual_id", "event_id", "phase", "matrix_variant_id", "sampled_alternate", "explicit_alternate", "incompatible"],
      "properties": {
        "population_id": {"type": "string", "minLength": 1}, "individual_id": {"type": "string", "minLength": 1}, "event_id": {"type": "string", "minLength": 1},
        "phase": {"type": "integer", "minimum": 0, "maximum": 9}, "matrix_variant_id": {"type": "string", "minLength": 1},
        "sampled_alternate": {"oneOf": [{"enum": ["A", "C", "G", "T"]}, {"type": "null"}]}, "explicit_alternate": {"enum": ["A", "C", "G", "T"]}, "incompatible": {"type": "boolean"}
      }
    },
    "initial_population_statistics_population": {
      "type": "object", "additionalProperties": false,
      "required": ["population_id", "genotype_model", "individual_count", "ploidy", "loci"],
      "properties": {
        "population_id": {"type": "string", "minLength": 1}, "genotype_model": {"$ref": "#/$defs/initial_genotype_model"},
        "individual_count": {"type": "integer", "minimum": 1}, "ploidy": {"type": "integer", "minimum": 1, "maximum": 10},
        "loci": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/initial_population_statistics_locus"}}
      }
    },
    "initial_population_statistics_locus": {
      "type": "object", "additionalProperties": false,
      "required": ["contig", "position_1based", "ref", "total_copies", "observed_copies", "missing_by_deletion", "alleles", "complete_genotype_observations", "genotypes"],
      "properties": {
        "contig": {"type": "string", "minLength": 1}, "position_1based": {"type": "integer", "minimum": 1}, "ref": {"enum": ["A", "C", "G", "T"]},
        "total_copies": {"type": "integer", "minimum": 1}, "observed_copies": {"type": "integer", "minimum": 0}, "missing_by_deletion": {"type": "integer", "minimum": 0},
        "alleles": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/initial_population_statistics_allele"}},
        "complete_genotype_observations": {"type": "integer", "minimum": 0}, "genotypes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/initial_population_statistics_genotype"}}
      }
    },
    "initial_population_statistics_allele": {
      "type": "object", "additionalProperties": false,
      "required": ["allele", "kind", "requested_frequency", "realized_count", "realized_frequency"],
      "properties": {
        "allele": {"enum": ["A", "C", "G", "T"]}, "kind": {"enum": ["ref", "alt"]}, "variant_id": {"type": "string", "minLength": 1}, "source_id": {"type": "string"},
        "requested_frequency": {"type": "number", "minimum": 0, "maximum": 1}, "realized_count": {"type": "integer", "minimum": 0}, "realized_frequency": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "ref"}}, "required": ["kind"]}, "then": {"not": {"anyOf": [{"required": ["variant_id"]}, {"required": ["source_id"]}]}}},
        {"if": {"properties": {"kind": {"const": "alt"}}, "required": ["kind"]}, "then": {"required": ["variant_id", "source_id"]}}
      ]
    },
    "initial_population_statistics_genotype": {
      "type": "object", "additionalProperties": false,
      "required": ["allele_dosages", "expected_probability", "expected_count", "realized_count"],
      "properties": {
        "allele_dosages": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 10}},
        "expected_probability": {"type": "number", "minimum": 0, "maximum": 1}, "expected_count": {"type": "number", "minimum": 0}, "realized_count": {"type": "integer", "minimum": 0}
      }
    },
    "normalization_audit": {
      "type": "array",
      "items": {"$ref": "#/$defs/normalization_audit_group"}
    },
    "normalization_audit_group": {
      "type": "object", "additionalProperties": false,
      "required": ["population_id", "contig", "position", "ref", "tolerance", "canonical_order", "sum_algorithm", "original_sum", "original_delta", "effective_sum", "effective_delta", "reference_frequency", "decision", "values"],
      "properties": {
        "population_id": {"type": "string", "minLength": 1}, "contig": {"type": "string", "minLength": 1},
        "position": {"type": "string", "pattern": "^[1-9][0-9]*$"}, "ref": {"enum": ["A", "C", "G", "T"]},
        "tolerance": {"type": "number", "minimum": 0, "maximum": 0.000001},
        "canonical_order": {"const": "population_id,contig,position,ref,alt,variant_id,source_id"}, "sum_algorithm": {"const": "neumaier_sum_v1"},
        "original_sum": {"type": "number", "minimum": 0}, "original_delta": {"type": "number", "minimum": 0},
        "effective_sum": {"type": "number", "minimum": 0}, "effective_delta": {"type": "number", "minimum": 0},
        "reference_frequency": {"type": "number", "minimum": 0, "maximum": 1}, "decision": {"enum": ["reference_remainder", "normalized"]},
        "values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/normalization_audit_value"}}
      }
    },
    "normalization_audit_value": {
      "type": "object", "additionalProperties": false,
      "required": ["alt", "variant_id", "source_id", "original", "effective"],
      "properties": {
        "alt": {"enum": ["A", "C", "G", "T"]}, "variant_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string"}, "original": {"type": "number", "minimum": 0, "maximum": 1},
        "effective": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "authorizations": {"type": "object", "additionalProperties": false, "required": ["allow_empty_snv_matrix", "allow_incompatible_genotypes"], "properties": {"allow_empty_snv_matrix": {"type": "boolean"}, "allow_incompatible_genotypes": {"type": "boolean"}}},
    "initial_population": {
      "type": "object", "additionalProperties": false,
      "required": ["population_id", "individual_count", "individual_ids", "ploidy", "genotype_model"],
      "properties": {
        "population_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "individual_count": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "individual_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}},
        "founder_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}},
        "ploidy": {"type": "integer", "minimum": 1, "maximum": 10},
        "genotype_model": {"$ref": "#/$defs/initial_genotype_model"}
      },
      "allOf": [{
        "if": {"properties": {"genotype_model": {"properties": {"kind": {"const": "f_diploid"}}, "required": ["kind"]}}, "required": ["genotype_model"]},
        "then": {"properties": {"ploidy": {"const": 2}}}
      }]
    },
    "initial_genotype_model": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["hwe", "f_diploid"]},
        "inbreeding_coefficient": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "hwe"}}, "not": {"required": ["inbreeding_coefficient"]}},
        {"properties": {"kind": {"const": "f_diploid"}}, "required": ["inbreeding_coefficient"]}
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "original_fasta_path", "canonical_format", "total_genome_size", "composition", "sequences", "fasta_artifact_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source": {"enum": ["simulated", "supplied"]},
        "original_fasta_path": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "canonical_format": {"oneOf": [{"$ref": "#/$defs/canonical_fasta"}, {"type": "null"}]},
        "total_genome_size": {"type": "integer", "minimum": 1},
        "composition": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["A", "C", "G", "T"],
              "properties": {"A": {"type": "number", "minimum": 0, "maximum": 1}, "C": {"type": "number", "minimum": 0, "maximum": 1}, "G": {"type": "number", "minimum": 0, "maximum": 1}, "T": {"type": "number", "minimum": 0, "maximum": 1}, "N": {"type": "number", "minimum": 0, "maximum": 1}}}
          ]
        },
        "sequences": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "class", "length", "header", "description", "alphabet_validation", "unknown_base_count"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "class": {"enum": ["chromosome", "scaffold"]},
            "length": {"type": "integer", "minimum": 1},
            "header": {"$ref": "#/$defs/reversible_text"},
            "description": {"oneOf": [{"$ref": "#/$defs/reversible_text"}, {"type": "null"}]},
            "alphabet_validation": {"const": "ACGTN-case-insensitive"},
            "unknown_base_count": {"type": "integer", "minimum": 0}
          }}},
        "fasta_artifact_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"source": {"const": "simulated"}}}, "then": {"properties": {"composition": {"type": "object"}, "original_fasta_path": {"type": "null"}, "canonical_format": {"$ref": "#/$defs/canonical_fasta"}}}},
        {"if": {"properties": {"source": {"const": "supplied"}}}, "then": {"properties": {"composition": {"type": "null"}, "original_fasta_path": {"type": "string", "minLength": 1}, "canonical_format": {"type": "null"}}}}
      ]
    },
    "canonical_fasta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "line_base_count", "line_ending", "base_case"],
      "properties": {
        "version": {"const": "1"},
        "line_base_count": {"const": 80},
        "line_ending": {"const": "LF"},
        "base_case": {"const": "uppercase"}
      }
    },
    "direct_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "individual_id", "phase", "kind", "contig"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "individual_id": {"type": "string", "minLength": 1},
        "phase": {"type": "integer", "minimum": 0, "maximum": 9},
        "kind": {"enum": ["snp", "insertion", "deletion"]},
        "contig": {"type": "string", "minLength": 1},
        "position_1based": {"type": "integer", "minimum": 1},
        "ref": {"enum": ["A", "C", "G", "T"]},
        "alt": {"enum": ["A", "C", "G", "T"]},
        "point": {"type": "integer", "minimum": 0},
        "bases": {"type": "string", "pattern": "^[ACGT]+$"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "snp"}}, "required": ["position_1based", "ref", "alt"]},
        {"properties": {"kind": {"const": "insertion"}}, "required": ["point", "bases"]},
        {"properties": {"kind": {"const": "deletion"}}, "required": ["start", "end"]}
      ]
    },
    "technical_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "individual_ids", "libraries", "profile", "read_length", "quality", "rng_catalog", "id_catalog", "target"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "individual_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}},
        "libraries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/technical_library"}},
        "profile": {"$ref": "#/$defs/technical_profile"},
        "read_length": {"type": "integer", "minimum": 1, "maximum": 150},
        "quality": {"type": "object", "additionalProperties": false, "required": ["acgt_phred", "n_phred"], "properties": {"acgt_phred": {"const": 40}, "n_phred": {"const": 0}}},
        "rng_catalog": {"const": "f4-technical-v3"},
        "id_catalog": {"$ref": "#/$defs/id_catalog"},
        "target": {"type": "object", "additionalProperties": false, "required": ["coverage_wgs"], "properties": {"coverage_wgs": {"type": "number", "minimum": 0}}}
      }
    },
    "technical_library": {
      "type": "object", "additionalProperties": false,
      "required": ["individual_id", "library_id", "i7", "i5", "is_contamination_recipient"],
      "properties": {
        "individual_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}, "library_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "i7": {"type": "string", "pattern": "^[ACGT]{8}$"},
        "i5": {"type": "string", "pattern": "^[ACGT]{8}$"}, "is_contamination_recipient": {"type": "boolean"}
      }
    },
    "technical_profile": {"type":"object","additionalProperties":false,"required":["id","resource_path","sha256","preparation"],"properties":{"id":{"const":"gps-hiseqx-pcrfree-pe150-v1"},"resource_path":{"const":"resources/f4/gps-hiseqx-pcrfree-pe150-v1.json"},"sha256":{"const":"3d8878ab920237dae03705276a26dbb0823941830d531374d35aa1c540f6deea"},"preparation":{"const":"pcr_free"}}},
    "id_catalog": {"type":"object","additionalProperties":false,"required":["version","derivations"],"properties":{"version":{"const":"3"},"derivations":{"type":"object","additionalProperties":false,"required":["v1","v2"],"properties":{"v1":{"const":["execution","reference","individual","event","batch","library","read_group","template"]},"v2":{"const":["PreHopInstanceId","TechnicalPairId"]}}}}},
    "reversible_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "value"],
      "properties": {
        "encoding": {"enum": ["utf-8", "bytes-hex"]},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"encoding": {"const": "bytes-hex"}}, "required": ["encoding"]},
        "then": {"properties": {"value": {"pattern": "^(?:[0-9a-f]{2})+$"}}}
      }]
    },
    "reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_reference_id", "region_size_bases", "target", "selection_subseed", "selection_order", "sequences", "state", "fasta_artifact_id", "map_artifact_id", "source_fasta_artifact_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source_reference_id": {"type": "string", "minLength": 1},
        "region_size_bases": {"type": "integer", "minimum": 1},
        "target": {"type": "object", "additionalProperties": false, "required": ["mode", "declared", "bases"],
          "properties": {"mode": {"enum": ["target_bases", "reduction_percent"]}, "declared": {"type": "string", "minLength": 1}, "bases": {"type": "integer", "minimum": 1}}},
        "selection_subseed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selection_order": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "sequences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/derived_sequence"}},
        "state": {"const": "complete"},
        "fasta_artifact_id": {"type": "string", "minLength": 1},
        "map_artifact_id": {"type": "string", "minLength": 1},
        "source_fasta_artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "derived_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "length", "header", "description", "alphabet_validation", "n_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"enum": ["chromosome", "scaffold"]},
        "length": {"type": "integer", "minimum": 1},
        "header": {"$ref": "#/$defs/reversible_text"},
        "description": {"oneOf": [{"$ref": "#/$defs/reversible_text"}, {"type": "null"}]},
        "alphabet_validation": {"const": "ACGTN-case-insensitive"},
        "n_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
