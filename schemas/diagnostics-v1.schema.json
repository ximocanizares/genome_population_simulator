{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genome-population-simulator.invalid/schemas/diagnostics-v1.schema.json",
  "title": "Genome population simulator diagnostics v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostic_kind", "schema_version", "exit_code", "diagnostics"],
  "properties": {
    "diagnostic_kind": { "const": "gps_diagnostics" },
    "schema_version": { "const": "1" },
    "exit_code": { "enum": [0, 1, 2, 3, 4, 5, 70] },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "severity", "message", "context"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^GPS-(CONF|INPUT|FMT|DOMAIN|RES|TOOL|IO|INTERNAL)-[0-9]{3}$"
        },
        "category": {
          "enum": ["CONF", "INPUT", "FMT", "DOMAIN", "RES", "TOOL", "IO", "INTERNAL"]
        },
        "severity": { "enum": ["warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null", "array", "object"]
          }
        },
        "causes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
