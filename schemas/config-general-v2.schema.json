{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genome-population-simulator.local/schemas/config-general-v2.schema.json",
  "title": "Configuración general v2",
  "description": "Vista estructural activa para autoría del TOML general F4. El binario Rust conserva la validación semántica.",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_kind", "schema_version", "reference"],
  "properties": {
    "config_kind": {
      "const": "general",
      "x-gps-tab": "General/Ejecución",
      "x-gps-control": "constant"
    },
    "schema_version": {
      "const": "2",
      "x-gps-tab": "General/Ejecución",
      "x-gps-control": "constant"
    },
    "seed": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Semilla raíz opcional de 256 bits.",
      "x-gps-tab": "General/Ejecución",
      "x-gps-control": "text"
    },
    "ploidy": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 2,
      "description": "Ploidía uniforme global. Si se omite, el valor efectivo es 2.",
      "x-gps-tab": "Individuos",
      "x-gps-control": "integer"
    },
    "normalization_tolerance": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 0.000001,
      "default": 0.000000001,
      "description": "Tolerancia absoluta general DTC-049 para sumas de frecuencias F2.",
      "x-gps-tab": "Población",
      "x-gps-control": "decimal-text"
    },
    "reference": {
      "oneOf": [
        { "$ref": "#/$defs/simulated_reference" },
        { "$ref": "#/$defs/supplied_reference" }
      ],
      "x-gps-tab": "Genoma"
    },
    "reduced_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reduced_reference" },
      "default": [],
      "x-gps-tab": "Genoma",
      "x-gps-control": "table"
    },
    "population_snvs": {
      "$ref": "#/$defs/population_snvs",
      "x-gps-tab": "Población"
    },
    "initial_populations": {
      "type": "array",
      "items": {"$ref": "#/$defs/initial_population"},
      "default": []
    },
    "direct_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/direct_event"},
      "default": [],
      "description": "Cambios explícitos por individuo ya faseado; requieren population_snvs e initial_populations."
    },
    "technical_event": {
      "$ref": "#/$defs/technical_event",
      "description": "Único evento técnico F4 Illumina paired-end; exige cobertura WGS y una biblioteca con UDI explícito por individuo."
    },
    "vcf_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["text", "bgzf"], "x-gps-control": "select"}
      },
      "description": "Vista VCF opcional de la verdad; ausente significa que no se genera VCF.",
      "x-gps-tab": "Salidas"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "x-gps-control": "text"
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "length"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "class": {
          "type": "string",
          "enum": ["chromosome", "scaffold"],
          "x-gps-control": "select"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615,
          "x-gps-control": "integer",
          "x-gps-unit": "bases"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "C", "G", "T"],
      "properties": {
        "A": { "$ref": "#/$defs/base_fraction" },
        "C": { "$ref": "#/$defs/base_fraction" },
        "G": { "$ref": "#/$defs/base_fraction" },
        "T": { "$ref": "#/$defs/base_fraction" },
        "N": { "$ref": "#/$defs/base_fraction", "description": "Fracción independiente de posiciones ambiguas; A/C/G/T siguen sumando 1." }
      }
    },
    "base_fraction": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "x-gps-control": "decimal-text",
      "x-gps-unit": "fraction"
    },
    "simulated_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "composition", "sequences"],
      "properties": {
        "kind": {
          "const": "simulated",
          "x-gps-control": "select"
        },
        "id": { "$ref": "#/$defs/identifier" },
        "composition": { "$ref": "#/$defs/composition" },
        "sequences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sequence" },
          "x-gps-control": "table"
        }
      }
    },
    "supplied_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "fasta", "sequences"],
      "properties": {
        "kind": {
          "const": "supplied",
          "x-gps-control": "select"
        },
        "id": { "$ref": "#/$defs/identifier" },
        "fasta": {
          "type": "string",
          "minLength": 1,
          "x-gps-control": "path"
        },
        "sequences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sequence" },
          "x-gps-control": "table"
        }
      }
    },
    "reduced_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_reference_id", "region_size_bases"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source_reference_id": { "$ref": "#/$defs/identifier" },
        "region_size_bases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615,
          "x-gps-control": "integer",
          "x-gps-unit": "bases"
        },
        "target_bases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615,
          "x-gps-control": "integer",
          "x-gps-unit": "bases"
        },
        "reduction_percent": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "exclusiveMaximum": 100.0,
          "x-gps-control": "decimal-text",
          "x-gps-unit": "percent"
        }
      },
      "oneOf": [
        {
          "required": ["target_bases"],
          "not": { "required": ["reduction_percent"] }
        },
        {
          "required": ["reduction_percent"],
          "not": { "required": ["target_bases"] }
        }
      ]
    },
    "population_snvs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["supplied", "reuse", "generate"],
          "x-gps-control": "select"
        },
        "input_path": { "type": "string", "minLength": 1, "x-gps-control": "path" },
        "metadata_path": { "type": "string", "minLength": 1, "x-gps-control": "path" },
        "generate": { "$ref": "#/$defs/population_snvs_generate" }
      },
      "oneOf": [
        {
          "properties": { "mode": { "const": "supplied" } },
          "required": ["input_path"],
          "not": { "anyOf": [{ "required": ["metadata_path"] }, { "required": ["generate"] }] }
        },
        {
          "properties": { "mode": { "const": "reuse" } },
          "required": ["metadata_path"],
          "not": { "anyOf": [{ "required": ["input_path"] }, { "required": ["generate"] }] }
        },
        {
          "properties": { "mode": { "const": "generate" } },
          "required": ["generate"],
          "not": { "anyOf": [{ "required": ["input_path"] }, { "required": ["metadata_path"] }] }
        }
      ]
    },
    "population_snvs_generate": {
      "type": "object", "additionalProperties": false,
      "required": ["count_mode", "spatial_mode", "substitution_profile", "populations"],
      "properties": {
        "count_mode": { "enum": ["exact", "poisson"] },
        "locus_count": { "type": "integer", "minimum": 0 },
        "mean_loci": { "type": "number", "minimum": 0 },
        "mean_density_per_base": { "type": "number", "minimum": 0 },
        "spatial_mode": { "enum": ["uniform", "weighted_regions"] },
        "substitution_profile": { "enum": ["uniform_snv12_v1", "human_harris2017_snv12_approx_v1"] },
        "outside_weight": { "type": "number", "minimum": 0 },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/population_snvs_region" } },
        "populations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/population_snvs_population" } }
      },
      "allOf": [
        { "oneOf": [
          { "properties": { "count_mode": { "const": "exact" } }, "required": ["locus_count"], "not": { "anyOf": [{ "required": ["mean_loci"] }, { "required": ["mean_density_per_base"] }] } },
          { "properties": { "count_mode": { "const": "poisson" } }, "not": { "required": ["locus_count"] } }
        ] },
        { "oneOf": [
          { "required": ["mean_loci"], "not": { "required": ["mean_density_per_base"] } },
          { "required": ["mean_density_per_base"], "not": { "required": ["mean_loci"] } },
          { "properties": { "count_mode": { "const": "exact" } }, "not": { "anyOf": [{ "required": ["mean_loci"] }, { "required": ["mean_density_per_base"] }] } }
        ] },
        { "oneOf": [
          { "properties": { "spatial_mode": { "const": "uniform" } }, "not": { "anyOf": [{ "required": ["outside_weight"] }, { "required": ["regions"] }] } },
          { "properties": { "spatial_mode": { "const": "weighted_regions" } }, "required": ["outside_weight"] }
        ] }
      ]
    },
    "population_snvs_region": { "type": "object", "additionalProperties": false, "required": ["contig", "start", "end", "weight"], "properties": { "contig": { "$ref": "#/$defs/identifier" }, "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "minimum": 1 }, "weight": { "type": "number", "minimum": 0 } } },
    "population_snvs_population": {
      "type": "object", "additionalProperties": false, "required": ["population_id", "frequency_model"],
      "properties": {
        "population_id": { "$ref": "#/$defs/identifier" },
        "frequency_model": { "enum": ["uniform", "spectrum", "human_1000g_global_sfs_approx_v1"] },
        "frequency_mode": { "enum": ["stochastic", "exact"], "default": "stochastic" },
        "min_alt_af": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "max_alt_af": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "spectrum": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/frequency_spectrum_component" }, "x-gps-control": "table" }
      },
      "oneOf": [
        { "properties": { "frequency_model": { "const": "uniform" } }, "required": ["min_alt_af", "max_alt_af"], "not": { "anyOf": [{ "required": ["spectrum"] }, { "required": ["frequency_mode"] }] } },
        { "properties": { "frequency_model": { "const": "spectrum" } }, "required": ["spectrum"], "not": { "anyOf": [{ "required": ["min_alt_af"] }, { "required": ["max_alt_af"] }] } },
        { "properties": { "frequency_model": { "const": "human_1000g_global_sfs_approx_v1" } }, "not": { "anyOf": [{ "required": ["min_alt_af"] }, { "required": ["max_alt_af"] }, { "required": ["spectrum"] }] } }
      ]
    },
    "frequency_spectrum_component": {
      "type": "object", "additionalProperties": false, "required": ["kind", "weight"],
      "properties": {
        "kind": { "enum": ["fixed", "interval"] },
        "fixed_alt_af": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_alt_af": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "max_alt_af": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "weight": { "type": "number", "minimum": 0 },
        "sampling": { "enum": ["linear_uniform", "log_uniform"] }
      },
      "oneOf": [
        { "properties": { "kind": { "const": "fixed" } }, "required": ["fixed_alt_af"], "not": { "anyOf": [{ "required": ["min_alt_af"] }, { "required": ["max_alt_af"] }, { "required": ["sampling"] }] } },
        { "properties": { "kind": { "const": "interval" } }, "required": ["min_alt_af", "max_alt_af", "sampling"], "not": { "required": ["fixed_alt_af"] } }
      ]
    },
    "initial_population": {
      "type": "object", "additionalProperties": false,
      "required": ["population_id", "individual_count", "ploidy", "genotype_model"],
      "properties": {
        "population_id": {"$ref": "#/$defs/identifier"},
        "individual_count": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "ploidy": {"type": "integer", "minimum": 1, "maximum": 10},
        "genotype_model": {"enum": ["hwe", "f_diploid"]},
        "inbreeding_coefficient": {"type": "number", "minimum": 0, "maximum": 1},
        "individual_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "founder_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      },
      "allOf": [
        {"if": {"properties": {"genotype_model": {"const": "hwe"}}, "required": ["genotype_model"]}, "then": {"not": {"required": ["inbreeding_coefficient"]}}},
        {"if": {"properties": {"genotype_model": {"const": "f_diploid"}}, "required": ["genotype_model"]}, "then": {"required": ["inbreeding_coefficient"], "properties": {"ploidy": {"const": 2}}}},
        {"oneOf": [
          {"required": ["individual_ids"], "not": {"required": ["founder_keys"]}},
          {"required": ["founder_keys"], "not": {"required": ["individual_ids"]}}
        ]}
      ]
    },
    "technical_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "individual_ids", "target_coverage_wgs", "libraries"],
      "properties": {
        "event_id": {"$ref": "#/$defs/identifier"},
        "individual_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "target_coverage_wgs": {"type": "number", "minimum": 0},
        "read_length_bases": {"type": "integer", "minimum": 1, "maximum": 150, "default": 150, "x-gps-unit": "bases"},
        "chimera_rate": {"type": "number", "minimum": 0, "maximum": 1, "default": 0, "x-gps-unit": "fraction"},
        "contamination_min_percent": {"type": "number", "minimum": 0, "maximum": 100, "default": 0, "x-gps-unit": "percent"},
        "contamination_max_percent": {"type": "number", "minimum": 0, "maximum": 100, "default": 0, "x-gps-unit": "percent"},
        "contamination_recipient_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "libraries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/technical_library"}, "x-gps-control": "table"}
      }
    },
    "technical_library": {
      "type": "object", "additionalProperties": false,
      "required": ["individual_id", "i7", "i5"],
      "properties": {
        "individual_id": {"$ref": "#/$defs/identifier"},
        "i7": {"type": "string", "pattern": "^[ACGT]{8}$", "x-gps-control": "text"},
        "i5": {"type": "string", "pattern": "^[ACGT]{8}$", "x-gps-control": "text"}
      }
    },
    "direct_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "individual_id", "phase", "kind", "contig"],
      "properties": {
        "event_id": {"$ref": "#/$defs/identifier"},
        "individual_id": {"$ref": "#/$defs/identifier"},
        "phase": {"type": "integer", "minimum": 0, "maximum": 9},
        "kind": {"enum": ["snp", "insertion", "deletion"]},
        "contig": {"$ref": "#/$defs/identifier"},
        "position_1based": {"type": "integer", "minimum": 1},
        "ref": {"enum": ["A", "C", "G", "T", "a", "c", "g", "t"]},
        "alt": {"enum": ["A", "C", "G", "T", "a", "c", "g", "t"]},
        "point": {"type": "integer", "minimum": 0},
        "bases": {"type": "string", "pattern": "^[ACGTacgt]+$"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "snp"}}, "required": ["position_1based", "ref", "alt"], "not": {"anyOf": [{"required": ["point"]}, {"required": ["bases"]}, {"required": ["start"]}, {"required": ["end"]}]}},
        {"properties": {"kind": {"const": "insertion"}}, "required": ["point", "bases"], "not": {"anyOf": [{"required": ["position_1based"]}, {"required": ["ref"]}, {"required": ["alt"]}, {"required": ["start"]}, {"required": ["end"]}]}},
        {"properties": {"kind": {"const": "deletion"}}, "required": ["start", "end"], "not": {"anyOf": [{"required": ["position_1based"]}, {"required": ["ref"]}, {"required": ["alt"]}, {"required": ["point"]}, {"required": ["bases"]}]}}
      ]
    }
  }
}
