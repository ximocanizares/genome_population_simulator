{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest-event-v2.schema.json",
  "title": "Manifiesto de evento técnico GPS v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_kind", "schema_version", "event_id", "event_type", "technology", "rng_catalog", "id_catalog", "state", "profile", "technical_batch_id", "selected_individuals", "event_subseed", "reference", "coverage", "final_fastq_summary", "error_quality", "demultiplexing", "artifacts", "outputs", "diagnostics"],
  "properties": {
    "manifest_kind": { "const": "gps_event_manifest" },
    "schema_version": { "const": "2" },
    "event_id": { "$ref": "#/$defs/id" },
    "event_type": { "const": "technical_sequencing" },
    "technology": { "const": "illumina-short-read-pe-v1" },
    "rng_catalog": { "const": "f4-technical-v3" },
    "id_catalog": { "$ref": "#/$defs/id_catalog" },
    "state": { "enum": ["incomplete", "complete", "failed"] },
    "profile": { "$ref": "#/$defs/profile" },
    "technical_batch_id": { "$ref": "#/$defs/id" },
    "selected_individuals": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/selected_individual" }
    },
    "event_subseed": { "$ref": "#/$defs/digest" },
    "reference": { "$ref": "#/$defs/reference" },
    "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
    "final_fastq_summary": { "type": "array", "items": { "$ref": "#/$defs/final_fastq_summary" } },
    "error_quality": { "$ref": "#/$defs/error_quality" },
    "demultiplexing": { "$ref": "#/$defs/demultiplexing" },
    "artifacts": { "$ref": "#/$defs/technical_artifacts" },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event_artifact" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "complete" } }, "required": ["state"] },
      "then": { "properties": { "final_fastq_summary": { "minItems": 1 } } },
      "else": { "properties": { "final_fastq_summary": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "state": { "const": "complete" } }, "required": ["state"] },
      "then": {
        "properties": {
          "outputs": { "items": { "properties": { "state": { "const": "complete" } }, "required": ["state"] } },
          "coverage": { "minItems": 1 },
          "diagnostics": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "state": { "enum": ["incomplete", "failed"] } }, "required": ["state"] },
      "then": {
        "properties": {
          "outputs": {
            "contains": { "properties": { "state": { "enum": ["incomplete", "failed"] } }, "required": ["state"] },
            "minContains": 1
          },
          "coverage": { "maxItems": 0 },
          "diagnostics": { "minItems": 1 }
        }
      }
    },
    {
      "properties": {
        "outputs": {
          "allOf": [
            { "contains": { "properties": { "mate": { "const": 1 } }, "required": ["mate"] }, "minContains": 1 },
            { "contains": { "properties": { "mate": { "const": 2 } }, "required": ["mate"] }, "minContains": 1 }
          ]
        }
      }
    }
  ],
  "$defs": {
    "id_catalog": {"type":"object","additionalProperties":false,"required":["version","derivations"],"properties":{"version":{"const":"3"},"derivations":{"type":"object","additionalProperties":false,"required":["v1","v2"],"properties":{"v1":{"const":["execution","reference","individual","event","batch","library","read_group","template"]},"v2":{"const":["PreHopInstanceId","TechnicalPairId"]}}}}},
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!INCOMPLETE$)(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\/$).+$"
    },
    "checksum": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": { "algorithm": { "const": "sha256" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "path", "size_bytes", "checksum"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/relative_path" }, "size_bytes": { "type": "integer", "minimum": 0 },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "fastq_artifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "properties": {
            "path": {
              "allOf": [
                { "$ref": "#/$defs/relative_path" },
                { "pattern": "^outputs/fastq/[A-Za-z0-9][A-Za-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._-]{0,63}_R[12]\\.fastq\\.gz$" }
              ]
            }
          },
          "required": ["path"]
        }
      ]
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "resource_path", "sha256", "preparation", "read_length", "quality"],
      "properties": {
        "id": { "const": "gps-hiseqx-pcrfree-pe150-v1" }, "read_length": { "type": "integer", "minimum": 1, "maximum": 150 },
        "resource_path": { "const": "resources/f4/gps-hiseqx-pcrfree-pe150-v1.json" },
        "sha256": { "const": "3d8878ab920237dae03705276a26dbb0823941830d531374d35aa1c540f6deea" },
        "preparation": { "const": "pcr_free" },
        "quality": {
          "type": "object", "additionalProperties": false,
          "required": ["acgt_phred", "n_phred"],
          "properties": { "acgt_phred": { "const": 40 }, "n_phred": { "const": 0 } }
        }
      }
    },
    "selected_individual": {
      "type": "object", "additionalProperties": false,
      "required": ["individual_id", "library_id", "read_group_id", "i7", "i5"],
      "properties": { "individual_id": { "$ref": "#/$defs/id" }, "library_id": { "$ref": "#/$defs/id" }, "read_group_id": { "$ref": "#/$defs/id" }, "i7": {"type": "string", "pattern": "^[ACGT]{8}$"}, "i5": {"type": "string", "pattern": "^[ACGT]{8}$"} }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_id", "fasta"],
      "properties": { "reference_id": { "$ref": "#/$defs/id" }, "fasta": { "$ref": "#/$defs/artifact" } }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["individual_id", "library_id", "target_x", "basic_x", "final_x", "denominator_bases", "n_bases"],
      "properties": {
        "individual_id": { "$ref": "#/$defs/id" }, "library_id": { "$ref": "#/$defs/id" },
        "target_x": { "type": "number", "minimum": 0 }, "basic_x": { "type": "number", "minimum": 0 },
        "final_x": { "$ref": "#/$defs/final_coverage" },
        "denominator_bases": { "type": "integer", "minimum": 1 }, "n_bases": { "type": "integer", "minimum": 0 }
      }
    },
    "final_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["own_x", "contaminant_x"],
      "properties": { "own_x": { "type": "number", "minimum": 0 }, "contaminant_x": { "type": "number", "minimum": 0 } }
    },
    "final_fastq_summary": {"type":"object","additionalProperties":false,"required":["individual_id","library_id","pair_count","read_count","base_count","own_pair_count","contaminant_pair_count","own_base_count","contaminant_base_count","n_base_count"],"properties":{"individual_id":{"$ref":"#/$defs/id"},"library_id":{"$ref":"#/$defs/id"},"pair_count":{"type":"integer","minimum":0},"read_count":{"type":"integer","minimum":0},"base_count":{"type":"integer","minimum":0},"own_pair_count":{"type":"integer","minimum":0},"contaminant_pair_count":{"type":"integer","minimum":0},"own_base_count":{"type":"integer","minimum":0},"contaminant_base_count":{"type":"integer","minimum":0},"n_base_count":{"type":"integer","minimum":0}}},
    "error_quality": {"type":"object","additionalProperties":false,"required":["requested_mode","effective_mode","qualities_represent_realized_error_probability","r1","r2"],"properties":{"requested_mode":{"enum":["enabled","disabled"]},"effective_mode":{"enum":["enabled","disabled"]},"qualities_represent_realized_error_probability":{"type":"boolean"},"r1":{"$ref":"#/$defs/error_quality_mate"},"r2":{"$ref":"#/$defs/error_quality_mate"}},"allOf":[{"if":{"properties":{"effective_mode":{"const":"enabled"}},"required":["effective_mode"]},"then":{"properties":{"requested_mode":{"const":"enabled"},"qualities_represent_realized_error_probability":{"const":true}}}},{"if":{"properties":{"effective_mode":{"const":"disabled"}},"required":["effective_mode"]},"then":{"properties":{"requested_mode":{"const":"disabled"},"qualities_represent_realized_error_probability":{"const":false},"r1":{"properties":{"errors":{"const":0}}},"r2":{"properties":{"errors":{"const":0}}}}}}]},
    "error_quality_mate": {"type":"object","additionalProperties":false,"required":["quality_shift","error_scale","opportunities","errors"],"properties":{"quality_shift":{"const":0},"error_scale":{"const":1},"opportunities":{"type":"integer","minimum":0},"errors":{"type":"integer","minimum":0}}},
    "demultiplexing": {"type":"object","additionalProperties":false,"required":["index_hopping_rate","reassigned_pairs","discarded_pairs","unassigned_pairs","reassigned_by_sample","discarded_by_sample","unassigned_by_sample","clean_fastq_published","individual_provenance_published"],"properties":{"index_hopping_rate":{"type":"number","minimum":0,"maximum":1},"reassigned_pairs":{"type":"integer","minimum":0},"discarded_pairs":{"type":"integer","minimum":0},"unassigned_pairs":{"type":"integer","minimum":0},"reassigned_by_sample":{"type":"array","items":{"$ref":"#/$defs/demultiplexing_reassignment"}},"discarded_by_sample":{"type":"array","items":{"$ref":"#/$defs/demultiplexing_discard"}},"unassigned_by_sample":{"type":"array","items":{"$ref":"#/$defs/demultiplexing_discard"}},"clean_fastq_published":{"const":false},"individual_provenance_published":{"const":false}}},
    "demultiplexing_reassignment": {"type":"object","additionalProperties":false,"required":["source_library_id","destination_library_id","cause","pair_count"],"properties":{"source_library_id":{"$ref":"#/$defs/id"},"destination_library_id":{"$ref":"#/$defs/id"},"cause":{"const":"index_hopping"},"pair_count":{"type":"integer","minimum":1}}},
    "demultiplexing_discard": {"type":"object","additionalProperties":false,"required":["source_library_id","cause","pair_count"],"properties":{"source_library_id":{"$ref":"#/$defs/id"},"cause":{"const":"unrecognized_udi"},"pair_count":{"type":"integer","minimum":1}}},
    "technical_artifacts": {"type":"object","additionalProperties":false,"required":["chimera","biological_contamination","pcr","optical_duplicates","gc","adapters"],"properties":{"chimera":{"type":"object","additionalProperties":false,"required":["rate","realized_pairs"],"properties":{"rate":{"type":"number","minimum":0,"maximum":1},"realized_pairs":{"type":"integer","minimum":0}},"allOf":[{"if":{"properties":{"rate":{"const":0}},"required":["rate"]},"then":{"properties":{"realized_pairs":{"const":0}}}}]},"biological_contamination":{"type":"array","items":{"$ref":"#/$defs/biological_contamination_recipient"}},"pcr":{"type":"object","additionalProperties":false,"required":["applicable"],"properties":{"applicable":{"const":false}}},"optical_duplicates":{"type":"object","additionalProperties":false,"required":["realized_pairs"],"properties":{"realized_pairs":{"const":0}}},"gc":{"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"const":"neutral"}}},"adapters":{"type":"object","additionalProperties":false,"required":["enabled"],"properties":{"enabled":{"const":false}}}}},
    "biological_contamination_recipient": {"type":"object","additionalProperties":false,"required":["recipient_id","recipient_library_id","percent_range","sampled_percent","clean_pair_count","target_pair_count","removed_own_pair_count","inserted_contaminant_pair_count","retained_own_pair_count","final_pair_count","subseeds","donor_contributions"],"properties":{"recipient_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},"recipient_library_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},"percent_range":{"type":"object","additionalProperties":false,"required":["minimum","maximum"],"properties":{"minimum":{"type":"number","minimum":0,"maximum":100},"maximum":{"type":"number","minimum":0,"maximum":100}}},"sampled_percent":{"type":"number","minimum":0,"maximum":100},"clean_pair_count":{"type":"integer","minimum":0},"target_pair_count":{"type":"integer","minimum":0},"removed_own_pair_count":{"type":"integer","minimum":0},"inserted_contaminant_pair_count":{"type":"integer","minimum":0},"retained_own_pair_count":{"type":"integer","minimum":0},"final_pair_count":{"type":"integer","minimum":0},"subseeds":{"type":"object","additionalProperties":false,"required":["percent","donors","removal"],"properties":{"percent":{"type":"string","pattern":"^[0-9a-f]{64}$"},"donors":{"type":"string","pattern":"^[0-9a-f]{64}$"},"removal":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},"donor_contributions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["individual_id","pairs"],"properties":{"individual_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},"pairs":{"type":"integer","minimum":1}}}}}},
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message"],
      "properties": { "code": { "$ref": "#/$defs/diagnostic_code" }, "message": { "type": "string", "minLength": 1 } }
    },
    "diagnostic_code": {
      "type": "string",
      "enum": [
        "GPS-CONF-001", "GPS-CONF-002", "GPS-CONF-003", "GPS-CONF-004", "GPS-CONF-005", "GPS-CONF-006", "GPS-CONF-007", "GPS-CONF-008", "GPS-CONF-009", "GPS-CONF-010", "GPS-CONF-011", "GPS-CONF-012", "GPS-CONF-013", "GPS-CONF-014", "GPS-CONF-015", "GPS-CONF-016", "GPS-CONF-017", "GPS-CONF-018", "GPS-CONF-019", "GPS-CONF-020", "GPS-CONF-021", "GPS-CONF-022",
        "GPS-INPUT-001", "GPS-INPUT-002",
        "GPS-FMT-001", "GPS-FMT-002", "GPS-FMT-003", "GPS-FMT-004", "GPS-FMT-005", "GPS-FMT-006", "GPS-FMT-007",
        "GPS-DOMAIN-001", "GPS-DOMAIN-002", "GPS-DOMAIN-003", "GPS-DOMAIN-004",
        "GPS-RES-001", "GPS-RES-002",
        "GPS-TOOL-001", "GPS-TOOL-002", "GPS-TOOL-003",
        "GPS-IO-001", "GPS-IO-002", "GPS-IO-003", "GPS-IO-004", "GPS-IO-005",
        "GPS-INTERNAL-001"
      ]
    },
    "event_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "state", "individual_id", "library_id", "mate", "artifact", "diagnostic_code"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "fastq" },
        "state": { "enum": ["incomplete", "complete", "failed"] },
        "individual_id": { "$ref": "#/$defs/id" }, "library_id": { "$ref": "#/$defs/id" },
        "mate": { "enum": [1, 2] },
        "artifact": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
        "diagnostic_code": { "oneOf": [{ "$ref": "#/$defs/diagnostic_code" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "complete" }, "mate": { "const": 1 } }, "required": ["state", "mate"] }, "then": { "properties": { "artifact": { "allOf": [{ "$ref": "#/$defs/fastq_artifact" }, { "properties": { "path": { "pattern": "_R1\\.fastq\\.gz$" } } }] }, "diagnostic_code": { "type": "null" } } } },
        { "if": { "properties": { "state": { "const": "complete" }, "mate": { "const": 2 } }, "required": ["state", "mate"] }, "then": { "properties": { "artifact": { "allOf": [{ "$ref": "#/$defs/fastq_artifact" }, { "properties": { "path": { "pattern": "_R2\\.fastq\\.gz$" } } }] }, "diagnostic_code": { "type": "null" } } } },
        { "if": { "properties": { "state": { "enum": ["incomplete", "failed"] } }, "required": ["state"] }, "then": { "properties": { "artifact": { "type": "null" }, "diagnostic_code": { "$ref": "#/$defs/diagnostic_code" } } } }
      ]
    }
  }
}
