{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest-general-v6.schema.json",
  "title": "Manifiesto general GPS v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_kind",
    "schema_version",
    "execution_id",
    "state",
    "configuration_input",
    "effective_config_artifact_id",
    "references",
    "reference_reductions",
    "vcf_outputs",
    "authorizations",
    "output_categories",
    "artifacts",
    "diagnostics",
    "technical_events",
    "repeat_loci"
  ],
  "properties": {
    "manifest_kind": {
      "const": "gps_execution_manifest"
    },
    "schema_version": {
      "const": "6"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "complete",
        "failed"
      ]
    },
    "configuration_input": {
      "oneOf": [
        {
          "$ref": "#/$defs/configuration_input"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_config_artifact_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/non_empty_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference_link"
      }
    },
    "reference_reductions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference_reduction"
      }
    },
    "population_snvs": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/population_snvs_link"
        }
      ]
    },
    "vcf_outputs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/vcf_output"
      }
    },
    "authorizations": {
      "$ref": "#/$defs/authorizations"
    },
    "output_categories": {
      "$ref": "#/$defs/output_categories"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event_link"
      }
    },
    "technical_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/technical_event_link"
      }
    },
    "repeat_loci": {
      "$ref": "#/$defs/repeat_loci"
    },
    "reference_insertion": {
      "$ref": "#/$defs/reference_insertion"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "complete"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "configuration_input": {
            "$ref": "#/$defs/configuration_input"
          },
          "effective_config_artifact_id": {
            "$ref": "#/$defs/non_empty_id"
          },
          "references": {
            "minItems": 1
          },
          "artifacts": {
            "contains": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "path"
              ],
              "properties": {
                "id": {
                  "const": "truth-jsonl"
                },
                "kind": {
                  "const": "truth_jsonl"
                },
                "path": {
                  "const": "outputs/truth.jsonl"
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          },
          "reference_reductions": {
            "items": {
              "properties": {
                "state": {
                  "const": "complete"
                }
              }
            }
          },
          "events": {
            "items": {
              "properties": {
                "state": {
                  "const": "complete"
                }
              }
            }
          },
          "diagnostics": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "diagnostics": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "normalization_audit": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalization_audit_group"
      }
    },
    "normalization_audit_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "contig",
        "position",
        "ref",
        "tolerance",
        "canonical_order",
        "sum_algorithm",
        "original_sum",
        "original_delta",
        "effective_sum",
        "effective_delta",
        "reference_frequency",
        "decision",
        "values"
      ],
      "properties": {
        "population_id": {
          "type": "string",
          "minLength": 1
        },
        "contig": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "ref": {
          "enum": [
            "A",
            "C",
            "G",
            "T"
          ]
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e-06
        },
        "canonical_order": {
          "const": "population_id,contig,position,ref,alt,variant_id,source_id"
        },
        "sum_algorithm": {
          "const": "neumaier_sum_v1"
        },
        "original_sum": {
          "type": "number",
          "minimum": 0
        },
        "original_delta": {
          "type": "number",
          "minimum": 0
        },
        "effective_sum": {
          "type": "number",
          "minimum": 0
        },
        "effective_delta": {
          "type": "number",
          "minimum": 0
        },
        "reference_frequency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decision": {
          "enum": [
            "reference_remainder",
            "normalized"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/normalization_audit_value"
          }
        }
      }
    },
    "normalization_audit_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alt",
        "variant_id",
        "source_id",
        "original",
        "effective"
      ],
      "properties": {
        "alt": {
          "enum": [
            "A",
            "C",
            "G",
            "T"
          ]
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string"
        },
        "original": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "effective": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_empty_snv_matrix",
        "allow_incompatible_genotypes"
      ],
      "properties": {
        "allow_empty_snv_matrix": {
          "type": "boolean"
        },
        "allow_incompatible_genotypes": {
          "type": "boolean"
        }
      }
    },
    "non_empty_id": {
      "type": "string",
      "minLength": 1
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "size_bytes",
        "checksum"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "kind": {
          "$ref": "#/$defs/non_empty_id"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!INCOMPLETE$)(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\/$).+$(?!\\n)"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        }
      }
    },
    "configuration_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "original_path",
        "artifact_id"
      ],
      "properties": {
        "kind": {
          "const": "general"
        },
        "original_path": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "$ref": "#/$defs/non_empty_id"
        }
      }
    },
    "reference_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fasta_artifact_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "fasta_artifact_id": {
          "$ref": "#/$defs/non_empty_id"
        }
      }
    },
    "reduction_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "declared",
        "bases"
      ],
      "properties": {
        "mode": {
          "enum": [
            "target_bases",
            "reduction_percent"
          ]
        },
        "declared": {
          "type": "string",
          "minLength": 1
        },
        "bases": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "reference_reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_reference_id",
        "eligible_bases",
        "region_size_bases",
        "target",
        "root_seed",
        "selection_subseed",
        "selection_order",
        "state",
        "fasta_artifact_id",
        "map_artifact_id",
        "source_fasta_artifact_id",
        "map_document_kind",
        "map_schema_version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "source_reference_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "eligible_bases": {
          "type": "integer",
          "minimum": 1
        },
        "region_size_bases": {
          "type": "integer",
          "minimum": 1
        },
        "target": {
          "$ref": "#/$defs/reduction_target"
        },
        "root_seed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection_subseed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "state": {
          "enum": [
            "incomplete",
            "complete",
            "failed"
          ]
        },
        "fasta_artifact_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/non_empty_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "map_artifact_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/non_empty_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_fasta_artifact_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/non_empty_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "map_document_kind": {
          "const": "reference_reduction_map"
        },
        "map_schema_version": {
          "const": "1"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "fasta_artifact_id": {
                "$ref": "#/$defs/non_empty_id"
              },
              "map_artifact_id": {
                "$ref": "#/$defs/non_empty_id"
              },
              "source_fasta_artifact_id": {
                "$ref": "#/$defs/non_empty_id"
              }
            }
          }
        }
      ]
    },
    "population_snvs_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "metadata_sha256",
        "normalization_audit"
      ],
      "properties": {
        "mode": {
          "enum": [
            "supplied",
            "generated",
            "reuse"
          ]
        },
        "metadata_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "metadata_artifact_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/non_empty_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "normalization_audit": {
          "$ref": "#/$defs/normalization_audit"
        },
        "initial_population_statistics": {
          "$ref": "#/$defs/initial_population_statistics"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "reuse"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "metadata_artifact_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "supplied",
                  "generated"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "metadata_artifact_id"
            ],
            "properties": {
              "metadata_artifact_id": {
                "$ref": "#/$defs/non_empty_id"
              }
            }
          }
        }
      ]
    },
    "vcf_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reference_id",
        "samples",
        "mode",
        "vcf_artifact_id",
        "index_kind",
        "index_artifact_id",
        "normalization_version"
      ],
      "properties": {
        "state": {
          "const": "complete"
        },
        "normalization_version": {
          "const": "vcf-small-allele-normalization-v2"
        },
        "reference_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "samples": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_id"
          }
        },
        "mode": {
          "enum": [
            "text",
            "bgzf"
          ]
        },
        "vcf_artifact_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "index_kind": {
          "oneOf": [
            {
              "enum": [
                "tbi",
                "csi"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "index_artifact_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/non_empty_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "text"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "index_kind": {
                "type": "null"
              },
              "index_artifact_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "bgzf"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "index_kind": {
                "enum": [
                  "tbi",
                  "csi"
                ]
              },
              "index_artifact_id": {
                "$ref": "#/$defs/non_empty_id"
              }
            }
          }
        }
      ]
    },
    "event_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "state",
        "manifest_artifact_id"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "state": {
          "enum": [
            "complete",
            "failed"
          ]
        },
        "manifest_artifact_id": {
          "$ref": "#/$defs/non_empty_id"
        }
      }
    },
    "technical_event_link": {
      "$comment": "El catálogo va atado al perfil, como en la configuración efectiva (DT-041, 12/10/2026): sin PCR, el v3 o el v4 del tartamudeo de base; con PCR, solo el v6 del tartamudeo clonal, porque esta versión solo la publica una ejecución con loci de repetición y con PCR y loci siempre hay tartamudeo clonal (DTC-092). El v5 de la amplificación sin loci vive en la versión 4.",
      "type": "object",
      "additionalProperties": false,
      "if": {
        "properties": {
          "profile": {
            "properties": {
              "id": {
                "const": "gps-hiseqx-pcr-pe150-v1"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "rng_catalog": {
            "const": "f4-technical-v6"
          }
        }
      },
      "else": {
        "properties": {
          "rng_catalog": {
            "enum": [
              "f4-technical-v3",
              "f4-technical-v4"
            ]
          }
        }
      },
      "required": [
        "event_id",
        "effective_config",
        "profile",
        "rng_catalog",
        "id_catalog",
        "artifacts",
        "event_manifest"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "effective_config": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sha256"
              ],
              "properties": {
                "id": {
                  "const": "gps-hiseqx-pcrfree-pe150-v1"
                },
                "sha256": {
                  "const": "3d8878ab920237dae03705276a26dbb0823941830d531374d35aa1c540f6deea"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sha256"
              ],
              "properties": {
                "id": {
                  "const": "gps-hiseqx-pcr-pe150-v1"
                },
                "sha256": {
                  "const": "83b00fb8d084df8f6aef0464fd2b0260cfefe3f89fc523b135da6bbf6595a03c"
                }
              }
            }
          ]
        },
        "rng_catalog": {
          "enum": [
            "f4-technical-v3",
            "f4-technical-v4",
            "f4-technical-v5",
            "f4-technical-v6"
          ]
        },
        "id_catalog": {
          "$ref": "#/$defs/f4_id_catalog"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chimera"
          ],
          "properties": {
            "chimera": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rate",
                "realized_pairs"
              ],
              "properties": {
                "rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "realized_pairs": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "rate": {
                        "const": 0
                      }
                    },
                    "required": [
                      "rate"
                    ]
                  },
                  "then": {
                    "properties": {
                      "realized_pairs": {
                        "const": 0
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "event_manifest": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "f4_id_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "derivations"
      ],
      "properties": {
        "version": {
          "const": "3"
        },
        "derivations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "v1",
            "v2"
          ],
          "properties": {
            "v1": {
              "const": [
                "execution",
                "reference",
                "individual",
                "event",
                "batch",
                "library",
                "read_group",
                "template"
              ]
            },
            "v2": {
              "const": [
                "PreHopInstanceId",
                "TechnicalPairId"
              ]
            }
          }
        }
      }
    },
    "initial_population_statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "provenance",
        "populations"
      ],
      "properties": {
        "kind": {
          "const": "initial_population_statistics"
        },
        "version": {
          "const": "1"
        },
        "provenance": {
          "$ref": "#/$defs/initial_population_statistics_provenance"
        },
        "populations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/initial_population_statistics_population"
          }
        }
      }
    },
    "initial_population_statistics_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_reference_id",
        "matrix_reference_fingerprint",
        "matrix_canonical_tsv_sha256",
        "genotype_algorithms",
        "missing_locus_policy",
        "explicit_snp_constraints"
      ],
      "properties": {
        "matrix_reference_id": {
          "type": "string",
          "minLength": 1
        },
        "matrix_reference_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "matrix_canonical_tsv_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "genotype_algorithms": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "hwe-composition-v1"
            },
            {
              "const": "f-diploid-genotype-v1"
            },
            {
              "const": "phase-permutation-v1"
            }
          ],
          "items": false
        },
        "missing_locus_policy": {
          "const": "missing_by_deletion_excluded_from_allele_frequency_denominator_v1"
        },
        "explicit_snp_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/explicit_snp_constraint"
          }
        }
      }
    },
    "explicit_snp_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id",
        "individual_id",
        "event_id",
        "phase",
        "matrix_variant_id",
        "sampled_alternate",
