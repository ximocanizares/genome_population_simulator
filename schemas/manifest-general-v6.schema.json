        "genotypes"
      ],
      "properties": {
        "contig": {
          "type": "string",
          "minLength": 1
        },
        "position_1based": {
          "type": "integer",
          "minimum": 1
        },
        "ref": {
          "enum": [
            "A",
            "C",
            "G",
            "T"
          ]
        },
        "total_copies": {
          "type": "integer",
          "minimum": 1
        },
        "observed_copies": {
          "type": "integer",
          "minimum": 0
        },
        "missing_by_deletion": {
          "type": "integer",
          "minimum": 0
        },
