          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "matrix_variant_id": {
          "type": "string",
          "minLength": 1
        },
        "sampled_alternate": {
          "oneOf": [
            {
              "enum": [
                "A",
                "C",
                "G",
                "T"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "explicit_alternate": {
          "enum": [
            "A",
            "C",
            "G",
            "T"
          ]
        },
        "incompatible": {
          "type": "boolean"
        }
      }
    },
