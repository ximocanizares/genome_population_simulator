    "initial_population_statistics_allele": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allele",
        "kind",
        "requested_frequency",
        "realized_count",
        "realized_frequency"
      ],
      "properties": {
        "allele": {
          "enum": [
            "A",
            "C",
            "G",
            "T"
          ]
        },
        "kind": {
          "enum": [
            "ref",
            "alt"
          ]
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string"
        },
        "requested_frequency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "realized_count": {
          "type": "integer",
          "minimum": 0
        },
        "realized_frequency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ref"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "variant_id"
                  ]
                },
                {
                  "required": [
                    "source_id"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "alt"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "variant_id",
              "source_id"
            ]
          }
        }
      ]
    },
    "initial_population_statistics_genotype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allele_dosages",
        "expected_probability",
        "expected_count",
        "realized_count"
      ],
      "properties": {
        "allele_dosages": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "expected_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "expected_count": {
          "type": "number",
          "minimum": 0
        },
        "realized_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "initial_genotype_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hwe",
            "f_diploid"
          ]
        },
        "inbreeding_coefficient": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "hwe"
            }
          },
          "not": {
            "required": [
              "inbreeding_coefficient"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "f_diploid"
            }
          },
          "required": [
            "inbreeding_coefficient"
          ]
        }
      ]
    },
    "output_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "defaulted",
        "requested",
        "disabled"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/id_set"
        },
        "defaulted": {
          "$ref": "#/$defs/id_set"
        },
        "requested": {
          "$ref": "#/$defs/id_set"
        },
        "disabled": {
          "$ref": "#/$defs/id_set"
        }
      }
    },
    "id_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_id"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^GPS-(CONF|INPUT|FMT|DOMAIN|RES|TOOL|IO|INTERNAL)-[0-9]{3}$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "u64_repeat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "repeat_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_purity",
        "min_longest_run_units"
      ],
      "properties": {
        "min_purity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_longest_run_units": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "repeat_allele": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "origin",
        "declared_frequency",
        "effective_frequency",
        "realized_frequency",
        "realized_copies",
        "units",
        "purity",
        "longest_run_units",
        "repeat_sequence_count",
        "block_motifs",
        "block_motif_lengths",
        "block_unit_counts",
        "block_bases",
        "interruptions"
      ],
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^[ACGTN]+$"
        },
        "origin": {
          "enum": [
            "declared",
            "generated"
          ],
          "description": "De donde salio este alelo: lo escribio el usuario, o lo produjo el generador de deslizamiento biologico partiendo del alelo de la referencia. Va por ALELO y no por locus para que un documento con loci de los dos tipos pueda distinguirlos sin volver a la configuracion."
        },
        "declared_frequency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "effective_frequency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "realized_frequency": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "realized_copies": {
          "$ref": "#/$defs/u64_repeat"
        },
        "units": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "purity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "longest_run_units": {
          "type": "integer",
          "minimum": 0
        },
        "repeat_sequence_count": {
          "type": "integer",
          "minimum": 1
        },
        "block_motifs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[ACGT]+$"
          }
        },
        "block_motif_lengths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "block_unit_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "block_bases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "interruptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offset",
              "length"
            ],
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "description": "Un alelo del locus. `declared_frequency` es la que se escribió, `effective_frequency` la normalizada y `realized_frequency` la que salió del sorteo: copias que recibió este alelo entre las copias sorteadas del locus. Las tres son distintas y ninguna se deriva de las otras. `realized_frequency` es nula cuando no se sorteó ninguna copia, porque un cero afirmaría una medida que no se hizo. Las cuatro listas de bloque son PARALELAS y todas miden lo que `repeat_sequence_count` declara. AVISO: este esquema NO puede comprobar ni esa correspondencia ni el par frecuencia/recuento, porque comparar la longitud de varias propiedades hermanas entre sí y contra un entero, o dividir dos campos, no es expresable en JSON Schema. Las sostiene el lector de Rust de ESTE documento, que comprueba las listas paralelas y exige que la frecuencia realizada sea bit a bit las copias realizadas entre las sorteadas, con su propia prueba de mutación."
    },
    "repeat_locus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "sequence_id",
        "start",
        "end",
        "motifs",
        "motif_lengths",
        "max_units",
        "admission",
        "drawn_copies",
        "alleles"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "origin": {
          "enum": [
            "declared",
            "detected"
          ],
          "description": "Declarado por el usuario o detectado en la referencia final."
        },
        "sequence_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "motifs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[ACGT]+$"
          }
        },
        "motif_lengths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "max_units": {
          "type": "integer",
          "minimum": 1
        },
        "admission": {
          "$ref": "#/$defs/repeat_admission"
        },
        "drawn_copies": {
          "$ref": "#/$defs/u64_repeat"
        },
        "alleles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repeat_allele"
          }
        },
        "slippage": {
          "$ref": "#/$defs/repeat_slippage"
        }
      },
      "description": "El locus con sus parámetros configurados: el intervalo en base uno cerrada, sus motivos, el TOPE de tamaño del tracto que se configuró y los MÍNIMOS de la guarda de admisión que se le aplicaron, que pueden ser los del locus o los generales."
    },
    "repeat_loci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "reference_source",
        "admission_defaults",
        "loci",
        "tract_output"
      ],
      "properties": {
        "reference_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "reference_source": {
          "enum": [
            "simulated",
            "supplied"
          ]
        },
        "admission_defaults": {
          "$ref": "#/$defs/repeat_admission"
        },
        "loci": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repeat_locus"
          }
        },
        "tract_output": {
          "$ref": "#/$defs/repeat_tract_output"
        }
      },
      "description": "Repeticiones en tándem de la ejecución. La PROCEDENCIA de la referencia va aquí porque de ella depende el significado de lo demás: con una referencia suministrada el tracto ya estaba en el genoma con las interrupciones que tuviera y la pureza es un valor observado; con una simulada lo puso el propio simulador. La sección existe solo en la versión 6, y la versión 6 existe solo cuando la configuración declara algún locus."
    },
    "repeat_tract_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_tract_bases_bound",
        "vcf_tract_bases_bound",
        "total_tract_bases_bound",
        "realized_truth_tract_bases",
        "realized_vcf_tract_bases",
        "realized_total_tract_bases"
      ],
      "properties": {
        "truth_tract_bases_bound": {
          "$ref": "#/$defs/u64_repeat"
        },
        "vcf_tract_bases_bound": {
          "$ref": "#/$defs/u64_repeat"
        },
        "total_tract_bases_bound": {
          "$ref": "#/$defs/u64_repeat"
        },
        "realized_truth_tract_bases": {
          "$ref": "#/$defs/u64_repeat"
        },
        "realized_vcf_tract_bases": {
          "$ref": "#/$defs/u64_repeat"
        },
        "realized_total_tract_bases": {
          "$ref": "#/$defs/u64_repeat"
        }
      },
      "description": "Contabilidad de bases de tracto. La COTA se repite aquí desde la configuración efectiva: su parte de la verdad se calculó sobre lo declarado y su parte del VCF es lo que el VCF lleva, medido al publicarlo. Lo REALIZADO se cuenta sobre lo publicado. AVISO: este esquema NO puede comprobar que lo realizado no supere la cota ni que sea lo que los documentos llevan; eso lo hace un juez independiente que recuenta releyendo el truth.jsonl y el VCF, sin tocar ninguna estructura del productor."
    },
    "repeat_slippage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "step_units",
        "mean_events",
        "expansion_bias",
        "algorithm",
        "count_algorithm",
        "bias_algorithm",
        "rng_scope",
        "rng_scope_catalog_version",
        "limitations",
        "lineages",
        "drawn_events",
        "applied_events",
        "unapplied_events"
      ],
      "description": "El generador de alelos por deslizamiento biologico de este locus: sus parametros, sus versiones y la contabilidad de la generacion. El bloque existe SOLO cuando el abanico lo genero el simulador; un locus con alelos declarados no lo lleva. AVISO: este esquema NO puede comprobar que applied_events mas unapplied_events sea drawn_events, porque sumar dos campos y compararlos con un tercero no es expresable en JSON Schema; lo sostiene el lector de Rust de este documento.",
      "properties": {
        "model": {
          "enum": [
            "stepwise"
          ]
        },
        "step_units": {
          "enum": [
            1
          ]
        },
        "mean_events": {
          "type": "number",
          "minimum": 0
        },
        "expansion_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "algorithm": {
          "enum": [
            "biological-slippage-v1"
          ]
        },
        "count_algorithm": {
          "enum": [
            "poisson-count-v1"
          ]
        },
        "bias_algorithm": {
          "enum": [
            "bernoulli-v1"
          ]
        },
        "rng_scope": {
          "enum": [
            "initial_repeat_slippage"
          ],
          "description": "Ambito de azar PROPIO, separado del tartamudeo: uno decide la verdad y el otro las lecturas. Se identifica por el evento y el identificador de locus, nunca por posicion ni por orden."
        },
        "rng_scope_catalog_version": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Las TRES limitaciones declaradas del modelo, que son decisiones biologicas y no detalles: no hay ancestria compartida, el numero de pasos no es un proceso en el tiempo, y el genoma de referencia puede llevar un alelo que ningun individuo tiene."
        },
        "lineages": {
          "type": "integer",
          "minimum": 1
        },
        "drawn_events": {
          "type": "integer",
          "minimum": 0
        },
        "applied_events": {
          "type": "integer",
          "minimum": 0
        },
        "unapplied_events": {
          "type": "integer",
          "minimum": 0,
          "description": "Eventos que NO se aplicaron porque ningun paso viable tenia peso positivo: el tracto llego a su minimo de una unidad completa en la tirada mas larga, o el linaje toco el tope. No es un error, es un resultado biologico legitimo, y es la cifra que distingue un servicio que ignora los eventos sobrantes de uno que los cuenta."
        }
      }
    },
    "reference_insertion": {
      "description": "Referencia FINAL de una ejecución que inserta tractos en la referencia suministrada (REQ-REF-37, REQ-MAN-07, DTC-098): su origen, sus artefactos y los cambios aplicados. La referencia final y la de origen están además en references. Solo aparece cuando algún locus inserta su tracto.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_reference_id",
        "state",
        "fasta_artifact_id",
        "map_artifact_id",
        "source_fasta_artifact_id",
        "map_document_kind",
        "map_schema_version",
        "insertions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "source_reference_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "state": {
          "enum": [
            "complete",
            "failed"
          ]
        },
        "fasta_artifact_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "map_artifact_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "source_fasta_artifact_id": {
          "$ref": "#/$defs/non_empty_id"
        },
        "map_document_kind": {
          "const": "reference_coordinate_map"
        },
        "map_schema_version": {
          "const": "2"
        },
        "insertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locus_id",
              "sequence_id",
              "insert_after",
              "inserted_bases"
            ],
            "properties": {
              "locus_id": {
                "type": "string",
                "minLength": 1
              },
              "sequence_id": {
                "type": "string",
                "minLength": 1
              },
              "insert_after": {
                "type": "integer",
                "minimum": 1,
                "description": "Base uno del genoma de partida tras la que entra el tracto."
              },
              "inserted_bases": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
