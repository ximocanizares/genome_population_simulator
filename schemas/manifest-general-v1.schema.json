{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest-general-v1.schema.json",
  "title": "Manifiesto general mínimo GPS v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_kind",
    "schema_version",
    "execution_id",
    "state",
    "configuration_input",
    "effective_config_artifact_id",
    "references",
    "reference_reductions",
    "output_categories",
    "artifacts",
    "diagnostics"
  ],
  "properties": {
    "manifest_kind": { "const": "gps_execution_manifest" },
    "schema_version": { "const": "1" },
    "execution_id": { "type": "string", "minLength": 1 },
    "state": { "enum": ["complete", "failed"] },
    "configuration_input": {
      "oneOf": [
        { "$ref": "#/$defs/configuration_input" },
        { "type": "null" }
      ]
    },
    "effective_config_artifact_id": {
      "oneOf": [
        { "$ref": "#/$defs/non_empty_id" },
        { "type": "null" }
      ]
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference_link" }
    },
    "reference_reductions": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference_reduction" }
    },
    "output_categories": { "$ref": "#/$defs/output_categories" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "complete" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "configuration_input": { "$ref": "#/$defs/configuration_input" },
          "effective_config_artifact_id": { "$ref": "#/$defs/non_empty_id" },
          "references": { "minItems": 1 },
          "reference_reductions": {
            "items": { "properties": { "state": { "const": "complete" } } }
          },
          "diagnostics": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "failed" } },
        "required": ["state"]
      },
      "then": {
        "properties": { "diagnostics": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "non_empty_id": { "type": "string", "minLength": 1 },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "size_bytes", "checksum"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_id" },
        "kind": { "$ref": "#/$defs/non_empty_id" },
        "path": {
          "type": "string",
          "pattern": "^(?!INCOMPLETE$)(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\/$).+$(?!\\n)"
        },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "configuration_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "original_path", "artifact_id"],
      "properties": {
        "kind": { "const": "general" },
        "original_path": { "type": "string", "minLength": 1 },
        "artifact_id": { "$ref": "#/$defs/non_empty_id" }
      }
    },
    "reference_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fasta_artifact_id"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_id" },
        "fasta_artifact_id": { "$ref": "#/$defs/non_empty_id" }
      }
    },
    "reduction_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "declared", "bases"],
      "properties": {
        "mode": { "enum": ["target_bases", "reduction_percent"] },
        "declared": { "type": "string", "minLength": 1 },
        "bases": { "type": "integer", "minimum": 1 }
      }
    },
    "reference_reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_reference_id",
        "eligible_bases",
        "region_size_bases",
        "target",
        "root_seed",
        "selection_algorithm",
        "selection_subseed",
        "selection_order",
        "state",
        "fasta_artifact_id",
        "map_artifact_id",
        "source_fasta_artifact_id",
        "map_document_kind",
        "map_schema_version"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_id" },
        "source_reference_id": { "$ref": "#/$defs/non_empty_id" },
        "eligible_bases": { "type": "integer", "minimum": 1 },
        "region_size_bases": { "type": "integer", "minimum": 1 },
        "target": { "$ref": "#/$defs/reduction_target" },
        "root_seed": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "selection_algorithm": { "const": "reduced_reference_selection_v1" },
        "selection_subseed": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "selection_order": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "state": { "enum": ["incomplete", "complete", "failed"] },
        "fasta_artifact_id": { "oneOf": [{ "$ref": "#/$defs/non_empty_id" }, { "type": "null" }] },
        "map_artifact_id": { "oneOf": [{ "$ref": "#/$defs/non_empty_id" }, { "type": "null" }] },
        "source_fasta_artifact_id": { "oneOf": [{ "$ref": "#/$defs/non_empty_id" }, { "type": "null" }] },
        "map_document_kind": { "const": "reference_reduction_map" },
        "map_schema_version": { "const": "1" }
      },
      "allOf": [{
        "if": { "properties": { "state": { "const": "complete" } }, "required": ["state"] },
        "then": { "properties": {
          "fasta_artifact_id": { "$ref": "#/$defs/non_empty_id" },
          "map_artifact_id": { "$ref": "#/$defs/non_empty_id" },
          "source_fasta_artifact_id": { "$ref": "#/$defs/non_empty_id" }
        }}
      }]
    },
    "output_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "defaulted", "requested", "disabled"],
      "properties": {
        "minimum": { "$ref": "#/$defs/id_set" },
        "defaulted": { "$ref": "#/$defs/id_set" },
        "requested": { "$ref": "#/$defs/id_set" },
        "disabled": { "$ref": "#/$defs/id_set" }
      }
    },
    "id_set": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_empty_id" }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^GPS-(CONF|INPUT|FMT|DOMAIN|RES|TOOL|IO|INTERNAL)-[0-9]{3}$"
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
