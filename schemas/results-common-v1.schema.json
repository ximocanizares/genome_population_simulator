{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results-common-v1.schema.json",
  "title": "Definiciones comunes de resultados GPS v1",
  "$comment": "Para gps_execution_manifest, manifest-general-runtime-validation-v1 compila en runtime exactamente manifest-general-v1.schema.json y este recurso Draft 2020-12 embebido; después aplica las igualdades dinámicas y cruza catálogo, instancia privada de workspace y árbol físico canónico mediante operaciones no-follow. Solo la capacidad opaca ligada a esa instancia y snapshot puede escribirse o publicarse; la enumeración se repite inmediatamente antes de la publicación atómica.",
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$(?!\\n)"
    },
    "diagnostic_code": {
      "type": "string",
      "pattern": "^GPS-(CONF|INPUT|FMT|DOMAIN|RES|TOOL|IO|INTERNAL)-[0-9]{3}$(?!\\n)"
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$(?!\\n)" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "size_bytes", "checksum", "state", "validated"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\/$).+$(?!\\n)" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "checksum": { "$ref": "#/$defs/checksum" },
        "state": { "enum": ["complete", "failed"] },
        "validated": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "complete" } } },
          "then": { "properties": { "validated": { "const": true } } }
        },
        {
          "if": { "properties": { "state": { "const": "failed" } } },
          "then": { "properties": { "validated": { "const": false } } }
        }
      ]
    },
    "complete_artifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "properties": {
            "state": { "const": "complete" },
            "validated": { "const": true }
          }
        }
      ]
    },
    "failed_reduction_artifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "properties": {
            "state": { "const": "failed" },
            "validated": { "const": false }
          },
          "oneOf": [
            {
              "properties": {
                "id": { "pattern": "^reference-fasta-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$(?!\\n)" },
                "kind": { "const": "reference_fasta" }
              }
            },
            {
              "properties": {
                "id": { "pattern": "^reference-map-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$(?!\\n)" },
                "kind": { "const": "reference_reduction_map" }
              }
            }
          ]
        }
      ]
    },
    "reversible_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "value"],
      "properties": {
        "encoding": { "enum": ["utf-8", "bytes-hex"] },
        "value": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "encoding": { "const": "bytes-hex" } } },
          "then": { "properties": { "value": { "pattern": "^(?:[0-9a-f]{2})*$(?!\\n)" } } }
        }
      ]
    },
    "reference_origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "generated" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "original_path"],
          "properties": {
            "kind": { "const": "supplied" },
            "original_path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source_reference_id"],
          "properties": {
            "kind": { "const": "reduced" },
            "source_reference_id": { "$ref": "#/$defs/stable_id" }
          }
        }
      ]
    },
    "canonical_fasta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "line_base_count", "line_ending", "base_case"],
      "properties": {
        "version": { "const": "1" },
        "line_base_count": { "const": 80 },
        "line_ending": { "const": "LF" },
        "base_case": { "const": "uppercase" }
      }
    },
    "reference_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "length", "ploidy", "header", "description", "alphabet_validation", "unknown_base_count"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "class": { "enum": ["chromosome", "scaffold"] },
        "length": { "type": "integer", "minimum": 1 },
        "ploidy": { "type": "integer", "minimum": 1, "maximum": 10 },
        "header": { "$ref": "#/$defs/reversible_text" },
        "description": { "oneOf": [{ "$ref": "#/$defs/reversible_text" }, { "type": "null" }] },
        "alphabet_validation": { "const": "ACGTN-case-insensitive" },
        "unknown_base_count": { "type": "integer", "minimum": 0 }
      }
    },
    "reference_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "total_genome_size", "origin", "authoritative_resource", "fasta", "canonical_format", "indexes", "sequences"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "total_genome_size": { "type": "integer", "minimum": 1 },
        "origin": { "$ref": "#/$defs/reference_origin" },
        "authoritative_resource": { "type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\/$).+$(?!\\n)" },
        "fasta": { "$ref": "#/$defs/artifact" },
        "canonical_format": { "oneOf": [{ "$ref": "#/$defs/canonical_fasta" }, { "type": "null" }] },
        "indexes": { "type": "array", "maxItems": 0 },
        "sequences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference_sequence" } }
      },
      "allOf": [
        {
          "if": { "properties": { "origin": { "properties": { "kind": { "const": "supplied" } }, "required": ["kind"] } } },
          "then": { "properties": { "canonical_format": { "type": "null" } } },
          "else": { "properties": { "canonical_format": { "$ref": "#/$defs/canonical_fasta" } } }
        }
      ]
    },
    "complete_reference_record": {
      "allOf": [
        { "$ref": "#/$defs/reference_record" },
        { "properties": { "fasta": { "$ref": "#/$defs/complete_artifact" } } }
      ]
    },
    "reference_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fasta", "indexes"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "fasta": { "$ref": "#/$defs/artifact" },
        "indexes": { "type": "array", "maxItems": 0 }
      }
    },
    "complete_reference_link": {
      "allOf": [
        { "$ref": "#/$defs/reference_link" },
        { "properties": { "fasta": { "$ref": "#/$defs/complete_artifact" } } }
      ]
    },
    "normalization_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "before", "after"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "before": { "type": "number" },
        "after": { "type": "number" }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "tolerance", "canonical_order", "algorithm", "algorithm_version", "sum_before", "delta_before", "decision", "values", "sum_after", "delta_after", "specific_tolerances"],
      "properties": {
        "parameter": { "type": "string", "minLength": 1 },
        "tolerance": { "type": "number", "minimum": 0, "maximum": 0.000001 },
        "canonical_order": { "const": "id,category" },
        "algorithm": { "const": "neumaier" },
        "algorithm_version": { "const": "1" },
        "sum_before": { "type": "number" },
        "delta_before": { "type": "number", "minimum": 0 },
        "decision": { "enum": ["accepted_without_change", "normalized"] },
        "values": { "type": "array", "items": { "$ref": "#/$defs/normalization_value" } },
        "sum_after": { "type": "number" },
        "delta_after": { "type": "number", "minimum": 0 },
        "specific_tolerances": { "type": "array", "maxItems": 0 }
      }
    },
    "controlled_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "count"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "controlled_frequency_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "counts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "counts": { "type": "array", "items": { "$ref": "#/$defs/controlled_count" } }
      }
    },
    "population_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["population", "subpopulation"] },
        "id": { "$ref": "#/$defs/stable_id" }
      }
    },
    "temporal_selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "phase" },
            "id": { "$ref": "#/$defs/stable_id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "generation"],
          "properties": {
            "kind": { "const": "generation" },
            "generation": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          }
        }
      ]
    },
    "spatial_selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "sequence"],
          "properties": {
            "kind": { "const": "sequence" },
            "reference": { "$ref": "#/$defs/stable_id" },
            "sequence": { "$ref": "#/$defs/stable_id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "sequence", "start", "end"],
          "properties": {
            "kind": { "const": "region" },
            "reference": { "$ref": "#/$defs/stable_id" },
            "sequence": { "$ref": "#/$defs/stable_id" },
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "sequence", "locus"],
          "properties": {
            "kind": { "const": "locus" },
            "reference": { "$ref": "#/$defs/stable_id" },
            "sequence": { "$ref": "#/$defs/stable_id" },
            "locus": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["individual", "population", "temporal", "spatial", "group", "block", "technical_event"],
      "properties": {
        "individual": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "population": { "oneOf": [{ "$ref": "#/$defs/population_selector" }, { "type": "null" }] },
        "temporal": { "oneOf": [{ "$ref": "#/$defs/temporal_selector" }, { "type": "null" }] },
        "spatial": { "oneOf": [{ "$ref": "#/$defs/spatial_selector" }, { "type": "null" }] },
        "group": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "block": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "technical_event": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "location"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "resolution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["individual", "population", "subpopulation", "phase", "generation", "reference", "sequence", "position", "locus", "group", "block", "technical_event"],
      "properties": {
        "individual": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "population": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "subpopulation": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "phase": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "generation": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "reference": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "sequence": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "position": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "locus": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "group": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "block": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] },
        "technical_event": { "oneOf": [{ "$ref": "#/$defs/stable_id" }, { "type": "null" }] }
      }
    },
    "effective_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "parameter", "resolution_context", "value", "winning_rule_id", "selectors", "provenance"],
      "properties": {
        "object_id": { "type": "string", "minLength": 1 },
        "parameter": { "enum": ["ploidy", "variant_rate", "selfing_rate", "recombination_rate", "coverage", "error_rate", "contamination_rate", "output_enabled"] },
        "resolution_context": { "$ref": "#/$defs/resolution_context" },
        "value": { "type": ["number", "string", "boolean"] },
        "winning_rule_id": { "type": "string", "minLength": 1 },
        "selectors": { "$ref": "#/$defs/selectors" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "resolution_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "version", "provider", "population_memberships", "phase_generation_intervals", "loci"],
      "properties": {
        "class": { "const": "resolution_domain" },
        "version": { "const": "1" },
        "provider": { "type": "string", "minLength": 1 },
        "population_memberships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["population", "subpopulation"],
            "properties": {
              "population": { "$ref": "#/$defs/stable_id" },
              "subpopulation": { "$ref": "#/$defs/stable_id" }
            }
          }
        },
        "phase_generation_intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "start", "end"],
            "properties": {
              "phase": { "$ref": "#/$defs/stable_id" },
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "loci": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reference", "sequence", "position"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reference": { "$ref": "#/$defs/stable_id" },
              "sequence": { "$ref": "#/$defs/stable_id" },
              "position": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "resolution_request_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "parameter", "resolution_context"],
      "properties": {
        "object_id": { "$ref": "#/$defs/stable_id" },
        "parameter": { "enum": ["ploidy", "variant_rate", "selfing_rate", "recombination_rate", "coverage", "error_rate", "contamination_rate", "output_enabled"] },
        "resolution_context": { "$ref": "#/$defs/resolution_context" }
      }
    },
    "resolution_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_evidence_kind", "schema_version", "parameter_order_version", "resolution_domain", "resolution_requests"],
      "properties": {
        "resolution_evidence_kind": { "const": "gps_resolution_evidence" },
        "schema_version": { "const": "1" },
        "parameter_order_version": { "const": "1" },
        "resolution_domain": { "$ref": "#/$defs/resolution_domain" },
        "resolution_requests": { "type": "array", "items": { "$ref": "#/$defs/resolution_request_input" } }
      }
    },
    "event_subseed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "subseed"],
      "properties": {
        "event_id": { "$ref": "#/$defs/stable_id" },
        "subseed": { "type": "string", "pattern": "^[0-9a-f]{64}$(?!\\n)" }
      }
    },
    "reduction_selection_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_order", "sequence_id", "start", "end"],
      "properties": {
        "selection_order": { "type": "integer", "minimum": 1 },
        "sequence_id": { "$ref": "#/$defs/stable_id" },
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "reference_reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_reference_id", "derived_reference_id", "source_fasta", "derived_fasta", "eligible_bases", "region_size_bases", "target", "randomness", "algorithm", "map", "included_sequence_ids", "omitted_sequence_ids", "has_residual", "selection_order"],
      "properties": {
        "source_reference_id": { "$ref": "#/$defs/stable_id" },
        "derived_reference_id": { "$ref": "#/$defs/stable_id" },
        "source_fasta": { "$ref": "#/$defs/artifact" },
        "derived_fasta": { "$ref": "#/$defs/artifact" },
        "eligible_bases": { "type": "integer", "minimum": 1 },
        "region_size_bases": { "type": "integer", "minimum": 1 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "declared_value", "derived_bases"],
          "properties": {
            "mode": { "enum": ["target_bases", "reduction_percent"] },
            "declared_value": { "type": "string", "minLength": 1 },
            "derived_bases": { "type": "integer", "minimum": 1 }
          }
        },
        "randomness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_seed", "subseed"],
          "properties": {
            "root_seed": { "type": "string", "pattern": "^[0-9a-f]{64}$(?!\\n)" },
            "subseed": { "type": "string", "pattern": "^[0-9a-f]{64}$(?!\\n)" }
          }
        },
        "algorithm": { "const": "reduced_reference_selection_v1" },
        "map": { "$ref": "#/$defs/artifact" },
        "included_sequence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stable_id" } },
        "omitted_sequence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stable_id" } },
        "has_residual": { "type": "boolean" },
        "selection_order": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reduction_selection_entry" } }
      }
    },
    "complete_reference_reduction": {
      "allOf": [
        { "$ref": "#/$defs/reference_reduction" },
        {
          "properties": {
            "source_fasta": { "$ref": "#/$defs/complete_artifact" },
            "derived_fasta": { "$ref": "#/$defs/complete_artifact" },
            "map": { "$ref": "#/$defs/complete_artifact" }
          }
        }
      ]
    },
    "failed_reference_reduction": {
      "allOf": [
        { "$ref": "#/$defs/reference_reduction" },
        {
          "properties": {
            "source_fasta": { "$ref": "#/$defs/complete_artifact" },
            "derived_fasta": { "$ref": "#/$defs/failed_reduction_artifact" },
            "map": { "$ref": "#/$defs/failed_reduction_artifact" }
          }
        }
      ]
    },
    "biological_reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status", "conditions"],
      "properties": {
        "level": { "const": "biological" },
        "status": { "const": "guaranteed" },
        "conditions": {
          "type": "array",
          "prefixItems": [{ "const": "simulator_version" }, { "const": "platform" }, { "const": "root_seed" }, { "const": "effective_configuration" }, { "const": "input_contents" }, { "const": "profiles" }, { "const": "random_algorithm" }, { "const": "subseed_catalog_v3" }, { "const": "reference_fasta_sha256" }],
          "items": false,
          "minItems": 9,
          "maxItems": 9
        }
      }
    },
    "technical_reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status", "conditions"],
      "properties": {
        "level": { "const": "technical" },
        "status": { "const": "not_applicable" },
        "conditions": { "type": "array", "maxItems": 0 }
      }
    },
    "semantic_reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status", "conditions"],
      "properties": {
        "level": { "const": "semantic" },
        "status": { "const": "not_guaranteed" },
        "conditions": {
          "type": "array",
          "prefixItems": [{ "const": "comparison_required" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "binary_reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status", "conditions"],
      "properties": {
        "level": { "const": "binary" },
        "status": { "const": "not_guaranteed" },
        "conditions": {
          "type": "array",
          "prefixItems": [{ "const": "format_specific_evidence_required" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "genome-population-simulator" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$(?!\\n)" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "official_target"],
      "properties": {
        "os": { "const": "linux" },
        "architecture": { "const": "x86_64" },
        "official_target": { "const": "x86_64-unknown-linux-gnu" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rustc", "cargo", "edition", "lock"],
      "properties": {
        "rustc": { "const": "1.97.1" },
        "cargo": { "const": "1.97.1" },
        "edition": { "const": "2024" },
        "lock": { "const": "Cargo.lock" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["blake3", "getrandom", "jsonschema", "noodles-fasta", "rand_chacha", "rustix", "serde_json", "sha2", "toml"] },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$(?!\\n)" }
      }
    },
    "dependency_blake3": {
      "allOf": [
        { "$ref": "#/$defs/dependency" },
        { "properties": { "name": { "const": "blake3" }, "version": { "const": "1.8.6" } } }
      ]
    },
    "dependency_getrandom": {
      "allOf": [
        { "$ref": "#/$defs/dependency" },
        { "properties": { "name": { "const": "getrandom" }, "version": { "const": "0.4.3" } } }
      ]
    },
    "dependency_jsonschema": {
      "allOf": [
        { "$ref": "#/$defs/dependency" },
        { "properties": { "name": { "const": "jsonschema" }, "version": { "const": "0.49.9" } } }
      ]
    },
    "dependency_rand_chacha": {
      "allOf": [
        { "$ref": "#/$defs/dependency" },
        { "properties": { "name": { "const": "rand_chacha" }, "version": { "const": "0.10.0" } } }
      ]
    },
    "dependency_noodles_fasta": {
      "allOf": [
        { "$ref": "#/$defs/dependency" },
        { "properties": { "name": { "const": "noodles-fasta" }, "version": { "const": "0.66.0" } } }
      ]
    },
    "dependency_rustix": {
      "allOf": [
        { "$ref": "#/$defs/dependency" },
        { "properties": { "name": { "const": "rustix" }, "version": { "const": "1.1.4" } } }
      ]
    },
    "dependency_serde_json": {
      "allOf": [
        { "$ref": "#/$defs/dependency" },
        { "properties": { "name": { "const": "serde_json" }, "version": { "const": "1.0.149" } } }
      ]
    },
    "dependency_sha2": {
      "allOf": [
        { "$ref": "#/$defs/dependency" },
        { "properties": { "name": { "const": "sha2" }, "version": { "const": "0.10.9" } } }
      ]
    },
    "dependency_toml": {
      "allOf": [
        { "$ref": "#/$defs/dependency" },
        { "properties": { "name": { "const": "toml" }, "version": { "const": "1.1.4" } } }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "enum": ["configuration_validation", "artifact_size_and_sha256", "result_json_internal_contract"] },
        "status": { "const": "passed" }
      }
    },
    "configuration_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "original_path", "copy"],
      "properties": {
        "kind": { "enum": ["general", "scenario"] },
        "original_path": { "type": "string", "minLength": 1 },
        "copy": { "$ref": "#/$defs/artifact" }
      }
    },
    "complete_configuration_input": {
      "allOf": [
        { "$ref": "#/$defs/configuration_input" },
        { "properties": { "copy": { "$ref": "#/$defs/complete_artifact" } } }
      ]
    },
    "event_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "subseed", "state", "manifest"],
      "properties": {
        "event_id": { "$ref": "#/$defs/stable_id" },
        "subseed": { "type": "string", "pattern": "^[0-9a-f]{64}$(?!\\n)" },
        "state": { "const": "complete" },
        "manifest": { "$ref": "#/$defs/artifact" }
      }
    },
    "complete_event_link": {
      "allOf": [
        { "$ref": "#/$defs/event_link" },
        { "properties": { "manifest": { "$ref": "#/$defs/complete_artifact" } } }
      ]
    },
    "complete_execution_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "state", "exportable", "diagnostic_code"],
      "properties": {
        "id": { "type": "string", "pattern": "^RUN_[A-Z2-7]{26}$(?!\\n)" },
        "kind": { "const": "execution" },
        "state": { "const": "complete" },
        "exportable": { "const": true },
        "diagnostic_code": { "type": "null" }
      }
    },
    "failed_execution_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "state", "exportable", "diagnostic_code"],
      "properties": {
        "id": { "type": "string", "pattern": "^RUN_[A-Z2-7]{26}$(?!\\n)" },
        "kind": { "const": "execution" },
        "state": { "const": "failed" },
        "exportable": { "const": false },
        "diagnostic_code": { "$ref": "#/$defs/diagnostic_code" }
      }
    },
    "complete_event_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "state", "exportable", "diagnostic_code"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "kind": { "const": "event" },
        "state": { "const": "complete" },
        "exportable": { "const": true },
        "diagnostic_code": { "type": "null" }
      }
    },
    "complete_reference_reduction_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "state", "exportable", "diagnostic_code"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "kind": { "const": "reference_reduction" },
        "state": { "const": "complete" },
        "exportable": { "const": true },
        "diagnostic_code": { "type": "null" }
      }
    },
    "failed_reference_reduction_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "state", "exportable", "diagnostic_code"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "kind": { "const": "reference_reduction" },
        "state": { "const": "failed" },
        "exportable": { "const": false },
        "diagnostic_code": { "$ref": "#/$defs/diagnostic_code" }
      }
    },
    "embedded_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "message", "context"],
      "properties": {
        "code": { "$ref": "#/$defs/diagnostic_code" },
        "category": { "enum": ["CONF", "INPUT", "FMT", "DOMAIN", "RES", "TOOL", "IO", "INTERNAL"] },
        "message": { "type": "string", "minLength": 1 },
        "context": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "general_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "default_enabled", "explicitly_requested", "disabled"],
      "properties": {
        "minimum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "contains": { "const": "manifest-general" },
          "minContains": 1,
          "maxContains": 1
        },
        "default_enabled": { "type": "array", "maxItems": 0 },
        "explicitly_requested": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "disabled": {
          "type": "array",
          "prefixItems": [{ "const": "truth" }, { "const": "vcf" }, { "const": "fastq" }, { "const": "bam" }, { "const": "cram" }],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      }
    },
    "event_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "default_enabled", "explicitly_requested", "disabled"],
      "properties": {
        "minimum": { "type": "array", "prefixItems": [{ "const": "manifest_event" }], "items": false, "minItems": 1, "maxItems": 1 },
        "default_enabled": { "type": "array", "maxItems": 0 },
        "explicitly_requested": { "type": "array", "maxItems": 0 },
        "disabled": {
          "type": "array",
          "prefixItems": [{ "const": "truth" }, { "const": "vcf" }, { "const": "fastq" }, { "const": "bam" }, { "const": "cram" }],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      }
    },
    "effective_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_config_kind", "schema_version", "source_path", "route", "reference", "reduced_references", "scenario_ids", "event_ids", "individual_ids", "parameter_order_version", "resolution_evidence_id", "resolution_domain", "randomness", "normalizations", "controlled_frequency_sets", "effective_values"],
      "properties": {
        "effective_config_kind": { "const": "gps_effective_config" },
        "schema_version": { "const": "1" },
        "source_path": { "type": "string", "minLength": 1 },
        "route": { "enum": ["direct", "evolution", "families"] },
        "reference": { "$ref": "#/$defs/reference_record" },
        "reduced_references": { "type": "array", "items": { "$ref": "#/$defs/reference_reduction" } },
        "scenario_ids": { "type": "array", "items": { "$ref": "#/$defs/stable_id" }, "uniqueItems": true },
        "event_ids": { "type": "array", "items": { "$ref": "#/$defs/stable_id" }, "uniqueItems": true },
        "individual_ids": { "type": "array", "items": { "$ref": "#/$defs/stable_id" }, "uniqueItems": true },
        "parameter_order_version": { "const": "1" },
        "resolution_evidence_id": { "const": "resolution-evidence" },
        "resolution_domain": { "$ref": "#/$defs/resolution_domain" },
        "randomness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_seed", "seed_origin", "algorithm", "derivation_version", "catalog_version", "event_subseeds"],
          "properties": {
            "root_seed": { "type": "string", "pattern": "^[0-9a-f]{64}$(?!\\n)" },
            "seed_origin": { "enum": ["declared", "system_csprng"] },
            "algorithm": { "const": "ChaCha12" },
            "derivation_version": { "const": 1 },
            "catalog_version": { "const": "3" },
            "event_subseeds": { "type": "array", "items": { "$ref": "#/$defs/event_subseed" } }
          }
        },
        "normalizations": { "type": "array", "items": { "$ref": "#/$defs/normalization" } },
        "controlled_frequency_sets": { "type": "array", "items": { "$ref": "#/$defs/controlled_frequency_set" } },
        "effective_values": { "type": "array", "items": { "$ref": "#/$defs/effective_value" } }
      }
    },
    "general_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_kind", "schema_version", "execution_id", "state", "route", "program", "platform", "toolchain", "dependencies", "tools", "profiles", "checks", "configuration_inputs", "resolution_evidence", "effective_config", "references", "reference_reductions", "events", "artifacts", "outputs", "normalizations", "reproducibility", "units", "diagnostics"],
      "properties": {
        "manifest_kind": { "const": "gps_execution_manifest" },
        "schema_version": { "const": "1" },
        "execution_id": { "type": "string", "pattern": "^RUN_[A-Z2-7]{26}$(?!\\n)" },
        "state": { "enum": ["complete", "failed"] },
        "route": { "enum": ["direct", "evolution", "families"] },
        "program": { "$ref": "#/$defs/program" },
        "platform": { "$ref": "#/$defs/platform" },
        "toolchain": { "$ref": "#/$defs/toolchain" },
        "dependencies": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/dependency_blake3" },
              { "$ref": "#/$defs/dependency_getrandom" },
              { "$ref": "#/$defs/dependency_jsonschema" },
              { "$ref": "#/$defs/dependency_noodles_fasta" },
              { "$ref": "#/$defs/dependency_rand_chacha" },
              { "$ref": "#/$defs/dependency_rustix" },
              { "$ref": "#/$defs/dependency_serde_json" },
              { "$ref": "#/$defs/dependency_sha2" },
              { "$ref": "#/$defs/dependency_toml" }
            ]
          },
          "allOf": [
            { "contains": { "$ref": "#/$defs/dependency_blake3" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/dependency_getrandom" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/dependency_jsonschema" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/dependency_noodles_fasta" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/dependency_rand_chacha" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/dependency_rustix" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/dependency_serde_json" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/dependency_sha2" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/dependency_toml" }, "minContains": 1, "maxContains": 1 }
          ]
        },
        "tools": { "type": "array", "maxItems": 0 },
        "profiles": { "type": "array", "maxItems": 0 },
        "checks": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/check" } },
        "configuration_inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/configuration_input" } },
        "resolution_evidence": { "$ref": "#/$defs/artifact" },
        "effective_config": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference_record" } },
        "reference_reductions": { "type": "array", "items": { "$ref": "#/$defs/reference_reduction" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event_link" } },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "outputs": { "$ref": "#/$defs/general_outputs" },
        "normalizations": { "type": "array", "items": { "$ref": "#/$defs/normalization" } },
        "reproducibility": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/biological_reproducibility" },
              { "$ref": "#/$defs/technical_reproducibility" },
              { "$ref": "#/$defs/semantic_reproducibility" },
              { "$ref": "#/$defs/binary_reproducibility" }
            ]
          },
          "allOf": [
            { "contains": { "$ref": "#/$defs/biological_reproducibility" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/technical_reproducibility" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/semantic_reproducibility" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "$ref": "#/$defs/binary_reproducibility" }, "minContains": 1, "maxContains": 1 }
          ]
        },
        "units": { "type": "array", "minItems": 1 },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/embedded_diagnostic" } }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "complete" } } },
          "then": {
            "properties": {
              "configuration_inputs": { "items": { "$ref": "#/$defs/complete_configuration_input" } },
              "effective_config": { "$ref": "#/$defs/complete_artifact" },
              "references": { "minItems": 1, "items": { "$ref": "#/$defs/complete_reference_record" } },
              "reference_reductions": { "items": { "$ref": "#/$defs/complete_reference_reduction" } },
              "events": { "items": { "$ref": "#/$defs/complete_event_link" } },
              "artifacts": { "items": { "$ref": "#/$defs/complete_artifact" } },
              "diagnostics": { "maxItems": 0 },
              "units": {
                "items": {
                  "oneOf": [
                    { "$ref": "#/$defs/complete_execution_unit" },
                    { "$ref": "#/$defs/complete_reference_reduction_unit" },
                    { "$ref": "#/$defs/complete_event_unit" }
                  ]
                },
                "contains": { "$ref": "#/$defs/complete_execution_unit" },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "failed" } } },
          "then": {
            "properties": {
              "configuration_inputs": { "items": { "$ref": "#/$defs/complete_configuration_input" } },
              "effective_config": { "oneOf": [{ "$ref": "#/$defs/complete_artifact" }, { "type": "null" }] },
              "references": { "items": { "$ref": "#/$defs/complete_reference_record" } },
              "reference_reductions": {
                "items": {
                  "oneOf": [
                    { "$ref": "#/$defs/complete_reference_reduction" },
                    { "$ref": "#/$defs/failed_reference_reduction" }
                  ]
                }
              },
              "events": { "maxItems": 0 },
              "artifacts": {
                "items": {
                  "oneOf": [
                    { "$ref": "#/$defs/complete_artifact" },
                    { "$ref": "#/$defs/failed_reduction_artifact" }
                  ]
                }
              },
              "diagnostics": { "minItems": 1 },
              "units": {
                "minItems": 1,
                "items": {
                  "oneOf": [
                    { "$ref": "#/$defs/failed_execution_unit" },
                    { "$ref": "#/$defs/complete_reference_reduction_unit" },
                    { "$ref": "#/$defs/failed_reference_reduction_unit" }
                  ]
                },
                "contains": { "$ref": "#/$defs/failed_execution_unit" },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        }
      ]
    },
    "event_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_kind", "schema_version", "event_id", "state", "subseed", "references", "artifacts", "outputs", "units", "diagnostics"],
      "properties": {
        "manifest_kind": { "const": "gps_event_manifest" },
        "schema_version": { "const": "1" },
        "event_id": { "$ref": "#/$defs/stable_id" },
        "state": { "const": "complete" },
        "subseed": { "type": "string", "pattern": "^[0-9a-f]{64}$(?!\\n)" },
        "references": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/complete_reference_link" } },
        "artifacts": { "type": "array", "maxItems": 0 },
        "outputs": { "$ref": "#/$defs/event_outputs" },
        "units": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/complete_event_unit" } },
        "diagnostics": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
