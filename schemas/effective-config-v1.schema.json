{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effective-config-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["effective_config_kind", "schema_version", "source_path", "ploidy", "normalization", "seed", "reference", "reduced_references", "authorizations", "initial_populations"],
  "properties": {
    "effective_config_kind": {"const": "gps_effective_config"},
    "schema_version": {"const": "1"},
    "source_path": {"type": "string", "minLength": 1},
    "ploidy": {"type": "integer", "minimum": 1, "maximum": 10},
    "normalization": {
      "type": "object", "additionalProperties": false,
      "required": ["tolerance", "canonical_order", "sum_algorithm"],
      "properties": {
        "tolerance": {"type": "number", "minimum": 0, "maximum": 0.000001},
        "canonical_order": {"const": "population_id,contig,position,ref,alt,variant_id,source_id"},
        "sum_algorithm": {"const": "neumaier_sum_v1"}
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "origin"],
      "properties": {
        "root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "origin": {"enum": ["declared", "system_csprng"]}
      }
    },
    "reference": {"$ref": "#/$defs/reference"},
    "authorizations": {"$ref": "#/$defs/authorizations"},
    "initial_populations": {"type": "array", "items": {"$ref": "#/$defs/initial_population"}},
    "population_snvs": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
          "required": ["mode", "metadata_sha256", "normalization_audit"],
          "properties": {
            "mode": {"enum": ["supplied", "generated", "reuse"]},
            "metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "metadata_artifact_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
            "normalization_audit": {"$ref": "#/$defs/normalization_audit"}
          },
          "allOf": [
            {"if": {"properties": {"mode": {"const": "reuse"}}, "required": ["mode"]}, "then": {"properties": {"metadata_artifact_id": {"type": "null"}}}},
            {"if": {"properties": {"mode": {"enum": ["supplied", "generated"]}}, "required": ["mode"]}, "then": {"required": ["metadata_artifact_id"], "properties": {"metadata_artifact_id": {"type": "string", "minLength": 1}}}}
          ]}
      ]
    },
    "reduced_references": {"type": "array", "items": {"$ref": "#/$defs/reduction"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reference": {
            "properties": {"source": {"const": "simulated"}},
            "required": ["source"]
          }
        },
        "required": ["reference"]
      },
      "then": {"properties": {"reduced_references": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "normalization_audit": {
      "type": "array",
      "items": {"$ref": "#/$defs/normalization_audit_group"}
    },
    "normalization_audit_group": {
      "type": "object", "additionalProperties": false,
      "required": ["population_id", "contig", "position", "ref", "tolerance", "canonical_order", "sum_algorithm", "original_sum", "original_delta", "effective_sum", "effective_delta", "reference_frequency", "decision", "values"],
      "properties": {
        "population_id": {"type": "string", "minLength": 1}, "contig": {"type": "string", "minLength": 1},
        "position": {"type": "string", "pattern": "^[1-9][0-9]*$"}, "ref": {"enum": ["A", "C", "G", "T"]},
        "tolerance": {"type": "number", "minimum": 0, "maximum": 0.000001},
        "canonical_order": {"const": "population_id,contig,position,ref,alt,variant_id,source_id"}, "sum_algorithm": {"const": "neumaier_sum_v1"},
        "original_sum": {"type": "number", "minimum": 0}, "original_delta": {"type": "number", "minimum": 0},
        "effective_sum": {"type": "number", "minimum": 0}, "effective_delta": {"type": "number", "minimum": 0},
        "reference_frequency": {"type": "number", "minimum": 0, "maximum": 1}, "decision": {"enum": ["reference_remainder", "normalized"]},
        "values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/normalization_audit_value"}}
      }
    },
    "normalization_audit_value": {
      "type": "object", "additionalProperties": false,
      "required": ["alt", "variant_id", "source_id", "original", "effective"],
      "properties": {
        "alt": {"enum": ["A", "C", "G", "T"]}, "variant_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string"}, "original": {"type": "number", "minimum": 0, "maximum": 1},
        "effective": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "authorizations": {"type": "object", "additionalProperties": false, "required": ["allow_empty_snv_matrix"], "properties": {"allow_empty_snv_matrix": {"type": "boolean"}}},
    "initial_population": {
      "type": "object", "additionalProperties": false,
      "required": ["population_id", "individual_count", "individual_ids", "ploidy", "genotype_model"],
      "properties": {
        "population_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "individual_count": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "individual_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}},
        "ploidy": {"type": "integer", "minimum": 1, "maximum": 10},
        "genotype_model": {"$ref": "#/$defs/initial_genotype_model"}
      },
      "allOf": [{
        "if": {"properties": {"genotype_model": {"properties": {"kind": {"const": "f_diploid"}}, "required": ["kind"]}}, "required": ["genotype_model"]},
        "then": {"properties": {"ploidy": {"const": 2}}}
      }]
    },
    "initial_genotype_model": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["hwe", "f_diploid"]},
        "inbreeding_coefficient": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "hwe"}}, "not": {"required": ["inbreeding_coefficient"]}},
        {"properties": {"kind": {"const": "f_diploid"}}, "required": ["inbreeding_coefficient"]}
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "original_fasta_path", "canonical_format", "total_genome_size", "composition", "sequences", "fasta_artifact_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source": {"enum": ["simulated", "supplied"]},
        "original_fasta_path": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "canonical_format": {"oneOf": [{"$ref": "#/$defs/canonical_fasta"}, {"type": "null"}]},
        "total_genome_size": {"type": "integer", "minimum": 1},
        "composition": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["A", "C", "G", "T"],
              "properties": {"A": {"type": "number", "minimum": 0, "maximum": 1}, "C": {"type": "number", "minimum": 0, "maximum": 1}, "G": {"type": "number", "minimum": 0, "maximum": 1}, "T": {"type": "number", "minimum": 0, "maximum": 1}}}
          ]
        },
        "sequences": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "class", "length", "header", "description", "alphabet_validation", "unknown_base_count"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "class": {"enum": ["chromosome", "scaffold"]},
            "length": {"type": "integer", "minimum": 1},
            "header": {"$ref": "#/$defs/reversible_text"},
            "description": {"oneOf": [{"$ref": "#/$defs/reversible_text"}, {"type": "null"}]},
            "alphabet_validation": {"const": "ACGTN-case-insensitive"},
            "unknown_base_count": {"type": "integer", "minimum": 0}
          }}},
        "fasta_artifact_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"source": {"const": "simulated"}}}, "then": {"properties": {"composition": {"type": "object"}, "original_fasta_path": {"type": "null"}, "canonical_format": {"$ref": "#/$defs/canonical_fasta"}}}},
        {"if": {"properties": {"source": {"const": "supplied"}}}, "then": {"properties": {"composition": {"type": "null"}, "original_fasta_path": {"type": "string", "minLength": 1}, "canonical_format": {"type": "null"}}}}
      ]
    },
    "canonical_fasta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "line_base_count", "line_ending", "base_case"],
      "properties": {
        "version": {"const": "1"},
        "line_base_count": {"const": 80},
        "line_ending": {"const": "LF"},
        "base_case": {"const": "uppercase"}
      }
    },
    "reversible_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "value"],
      "properties": {
        "encoding": {"enum": ["utf-8", "bytes-hex"]},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"encoding": {"const": "bytes-hex"}}, "required": ["encoding"]},
        "then": {"properties": {"value": {"pattern": "^(?:[0-9a-f]{2})+$"}}}
      }]
    },
    "reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_reference_id", "region_size_bases", "target", "selection_algorithm", "selection_subseed", "selection_order", "sequences", "state", "fasta_artifact_id", "map_artifact_id", "source_fasta_artifact_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source_reference_id": {"type": "string", "minLength": 1},
        "region_size_bases": {"type": "integer", "minimum": 1},
        "target": {"type": "object", "additionalProperties": false, "required": ["mode", "declared", "bases"],
          "properties": {"mode": {"enum": ["target_bases", "reduction_percent"]}, "declared": {"type": "string", "minLength": 1}, "bases": {"type": "integer", "minimum": 1}}},
        "selection_algorithm": {"const": "reduced_reference_selection_v1"},
        "selection_subseed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selection_order": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "sequences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/derived_sequence"}},
        "state": {"const": "complete"},
        "fasta_artifact_id": {"type": "string", "minLength": 1},
        "map_artifact_id": {"type": "string", "minLength": 1},
        "source_fasta_artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "derived_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "length", "header", "description", "alphabet_validation", "n_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"enum": ["chromosome", "scaffold"]},
        "length": {"type": "integer", "minimum": 1},
        "header": {"$ref": "#/$defs/reversible_text"},
        "description": {"oneOf": [{"$ref": "#/$defs/reversible_text"}, {"type": "null"}]},
        "alphabet_validation": {"const": "ACGTN-case-insensitive"},
        "n_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
