{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effective-config-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["effective_config_kind", "schema_version", "source_path", "seed", "reference", "reduced_references"],
  "properties": {
    "effective_config_kind": {"const": "gps_effective_config"},
    "schema_version": {"const": "1"},
    "source_path": {"type": "string", "minLength": 1},
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "origin"],
      "properties": {
        "root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "origin": {"enum": ["declared", "system_csprng"]}
      }
    },
    "reference": {"$ref": "#/$defs/reference"},
    "reduced_references": {"type": "array", "items": {"$ref": "#/$defs/reduction"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reference": {
            "properties": {"source": {"const": "simulated"}},
            "required": ["source"]
          }
        },
        "required": ["reference"]
      },
      "then": {"properties": {"reduced_references": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "total_genome_size", "composition", "sequences", "fasta_artifact_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source": {"enum": ["simulated", "supplied"]},
        "total_genome_size": {"type": "integer", "minimum": 1},
        "composition": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["A", "C", "G", "T"],
              "properties": {"A": {"type": "number", "minimum": 0, "maximum": 1}, "C": {"type": "number", "minimum": 0, "maximum": 1}, "G": {"type": "number", "minimum": 0, "maximum": 1}, "T": {"type": "number", "minimum": 0, "maximum": 1}}}
          ]
        },
        "sequences": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "class", "length", "unknown_base_count"],
          "properties": {"id": {"type": "string", "minLength": 1}, "class": {"enum": ["chromosome", "scaffold"]}, "length": {"type": "integer", "minimum": 1}, "unknown_base_count": {"type": "integer", "minimum": 0}}}},
        "fasta_artifact_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"source": {"const": "simulated"}}}, "then": {"properties": {"composition": {"type": "object"}}}},
        {"if": {"properties": {"source": {"const": "supplied"}}}, "then": {"properties": {"composition": {"type": "null"}}}}
      ]
    },
    "reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_reference_id", "region_size_bases", "target", "selection_subseed", "selection_order", "state", "fasta_artifact_id", "map_artifact_id", "source_fasta_artifact_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source_reference_id": {"type": "string", "minLength": 1},
        "region_size_bases": {"type": "integer", "minimum": 1},
        "target": {"type": "object", "additionalProperties": false, "required": ["mode", "declared", "bases"],
          "properties": {"mode": {"enum": ["target_bases", "reduction_percent"]}, "declared": {"type": "string", "minLength": 1}, "bases": {"type": "integer", "minimum": 1}}},
        "selection_subseed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selection_order": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "state": {"const": "complete"},
        "fasta_artifact_id": {"type": "string", "minLength": 1},
        "map_artifact_id": {"type": "string", "minLength": 1},
        "source_fasta_artifact_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
