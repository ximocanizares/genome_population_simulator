{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effective-config-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["effective_config_kind", "schema_version", "source_path", "ploidy", "normalization", "seed", "reference", "reduced_references"],
  "properties": {
    "effective_config_kind": {"const": "gps_effective_config"},
    "schema_version": {"const": "1"},
    "source_path": {"type": "string", "minLength": 1},
    "ploidy": {"type": "integer", "minimum": 1, "maximum": 10},
    "normalization": {
      "type": "object", "additionalProperties": false,
      "required": ["tolerance", "canonical_order", "sum_algorithm"],
      "properties": {
        "tolerance": {"type": "number", "minimum": 0, "maximum": 0.000001},
        "canonical_order": {"const": "population_id,contig,position,ref,alt,variant_id,source_id"},
        "sum_algorithm": {"const": "neumaier_sum_v1"}
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "origin"],
      "properties": {
        "root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "origin": {"enum": ["declared", "system_csprng"]}
      }
    },
    "reference": {"$ref": "#/$defs/reference"},
    "reduced_references": {"type": "array", "items": {"$ref": "#/$defs/reduction"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reference": {
            "properties": {"source": {"const": "simulated"}},
            "required": ["source"]
          }
        },
        "required": ["reference"]
      },
      "then": {"properties": {"reduced_references": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "original_fasta_path", "canonical_format", "total_genome_size", "composition", "sequences", "fasta_artifact_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source": {"enum": ["simulated", "supplied"]},
        "original_fasta_path": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "canonical_format": {"oneOf": [{"$ref": "#/$defs/canonical_fasta"}, {"type": "null"}]},
        "total_genome_size": {"type": "integer", "minimum": 1},
        "composition": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["A", "C", "G", "T"],
              "properties": {"A": {"type": "number", "minimum": 0, "maximum": 1}, "C": {"type": "number", "minimum": 0, "maximum": 1}, "G": {"type": "number", "minimum": 0, "maximum": 1}, "T": {"type": "number", "minimum": 0, "maximum": 1}}}
          ]
        },
        "sequences": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "class", "length", "header", "description", "alphabet_validation", "unknown_base_count"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "class": {"enum": ["chromosome", "scaffold"]},
            "length": {"type": "integer", "minimum": 1},
            "header": {"$ref": "#/$defs/reversible_text"},
            "description": {"oneOf": [{"$ref": "#/$defs/reversible_text"}, {"type": "null"}]},
            "alphabet_validation": {"const": "ACGTN-case-insensitive"},
            "unknown_base_count": {"type": "integer", "minimum": 0}
          }}},
        "fasta_artifact_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"source": {"const": "simulated"}}}, "then": {"properties": {"composition": {"type": "object"}, "original_fasta_path": {"type": "null"}, "canonical_format": {"$ref": "#/$defs/canonical_fasta"}}}},
        {"if": {"properties": {"source": {"const": "supplied"}}}, "then": {"properties": {"composition": {"type": "null"}, "original_fasta_path": {"type": "string", "minLength": 1}, "canonical_format": {"type": "null"}}}}
      ]
    },
    "canonical_fasta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "line_base_count", "line_ending", "base_case"],
      "properties": {
        "version": {"const": "1"},
        "line_base_count": {"const": 80},
        "line_ending": {"const": "LF"},
        "base_case": {"const": "uppercase"}
      }
    },
    "reversible_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "value"],
      "properties": {
        "encoding": {"enum": ["utf-8", "bytes-hex"]},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"encoding": {"const": "bytes-hex"}}, "required": ["encoding"]},
        "then": {"properties": {"value": {"pattern": "^(?:[0-9a-f]{2})+$"}}}
      }]
    },
    "reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_reference_id", "region_size_bases", "target", "selection_algorithm", "selection_subseed", "selection_order", "sequences", "state", "fasta_artifact_id", "map_artifact_id", "source_fasta_artifact_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source_reference_id": {"type": "string", "minLength": 1},
        "region_size_bases": {"type": "integer", "minimum": 1},
        "target": {"type": "object", "additionalProperties": false, "required": ["mode", "declared", "bases"],
          "properties": {"mode": {"enum": ["target_bases", "reduction_percent"]}, "declared": {"type": "string", "minLength": 1}, "bases": {"type": "integer", "minimum": 1}}},
        "selection_algorithm": {"const": "reduced_reference_selection_v1"},
        "selection_subseed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selection_order": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "sequences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/derived_sequence"}},
        "state": {"const": "complete"},
        "fasta_artifact_id": {"type": "string", "minLength": 1},
        "map_artifact_id": {"type": "string", "minLength": 1},
        "source_fasta_artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "derived_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "length", "header", "description", "alphabet_validation", "n_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"enum": ["chromosome", "scaffold"]},
        "length": {"type": "integer", "minimum": 1},
        "header": {"$ref": "#/$defs/reversible_text"},
        "description": {"oneOf": [{"$ref": "#/$defs/reversible_text"}, {"type": "null"}]},
        "alphabet_validation": {"const": "ACGTN-case-insensitive"},
        "n_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
