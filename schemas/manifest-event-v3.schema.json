{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "manifest-event-v3.schema.json",
 "title": "Manifiesto de evento técnico GPS v3",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "manifest_kind",
  "schema_version",
  "event_id",
  "event_type",
  "technology",
  "rng_catalog",
  "id_catalog",
  "state",
  "profile",
  "technical_batch_id",
  "selected_individuals",
  "event_subseed",
  "reference",
  "coverage",
  "final_fastq_summary",
  "error_quality",
  "demultiplexing",
  "artifacts",
  "outputs",
  "diagnostics"
 ],
 "properties": {
  "manifest_kind": {
   "const": "gps_event_manifest"
  },
  "schema_version": {
   "const": "3"
  },
  "event_id": {
   "$ref": "#/$defs/id"
  },
  "event_type": {
   "const": "technical_sequencing"
  },
  "technology": {
   "const": "illumina-short-read-pe-v1"
  },
  "rng_catalog": {
   "enum": [
    "f4-technical-v3",
    "f4-technical-v4",
    "f4-technical-v5"
   ]
  },
  "id_catalog": {
   "$ref": "#/$defs/id_catalog"
  },
  "state": {
   "enum": [
    "incomplete",
    "complete",
    "failed"
   ]
  },
  "profile": {
   "$ref": "#/$defs/profile"
  },
  "technical_batch_id": {
   "$ref": "#/$defs/id"
  },
  "selected_individuals": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "$ref": "#/$defs/selected_individual"
   }
  },
  "event_subseed": {
   "$ref": "#/$defs/digest"
  },
  "reference": {
   "$ref": "#/$defs/reference"
  },
  "coverage": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/coverage"
   }
  },
  "final_fastq_summary": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/final_fastq_summary"
   }
  },
  "error_quality": {
   "$ref": "#/$defs/error_quality"
  },
  "demultiplexing": {
   "$ref": "#/$defs/demultiplexing"
  },
  "artifacts": {
   "$ref": "#/$defs/technical_artifacts"
  },
  "outputs": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/event_artifact"
   }
  },
  "diagnostics": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/diagnostic"
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "state": {
      "const": "complete"
     }
    },
    "required": [
     "state"
    ]
   },
   "then": {
    "properties": {
     "final_fastq_summary": {
      "minItems": 1
     }
    }
   },
   "else": {
    "properties": {
     "final_fastq_summary": {
      "maxItems": 0
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "state": {
      "const": "complete"
     }
    },
    "required": [
     "state"
    ]
   },
   "then": {
    "properties": {
     "outputs": {
      "items": {
       "properties": {
        "state": {
         "const": "complete"
        }
       },
       "required": [
        "state"
       ]
      }
     },
     "coverage": {
      "minItems": 1
     },
     "diagnostics": {
      "maxItems": 0
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "state": {
      "enum": [
       "incomplete",
       "failed"
      ]
     }
    },
    "required": [
     "state"
    ]
   },
   "then": {
    "properties": {
     "outputs": {
      "contains": {
       "properties": {
        "state": {
         "enum": [
          "incomplete",
          "failed"
         ]
        }
       },
       "required": [
        "state"
       ]
      },
      "minContains": 1
     },
     "coverage": {
      "maxItems": 0
     },
     "diagnostics": {
      "minItems": 1
     }
    }
   }
  },
  {
   "properties": {
    "outputs": {
     "allOf": [
      {
       "contains": {
        "properties": {
         "mate": {
          "const": 1
         }
        },
        "required": [
         "mate"
        ]
       },
       "minContains": 1
      },
      {
       "contains": {
        "properties": {
         "mate": {
          "const": 2
         }
        },
        "required": [
         "mate"
        ]
       },
       "minContains": 1
      }
     ]
    }
   }
  },
  {
   "$comment": "La amplificación estrena el v5 y manda sobre el v4.",
   "if": {
    "properties": {
     "artifacts": {
      "properties": {
       "pcr": {
        "required": [
         "applicable"
        ],
        "properties": {
         "applicable": {
          "const": true
         }
        }
       }
      },
      "required": [
       "pcr"
      ]
     }
    },
    "required": [
     "artifacts"
    ]
   },
   "then": {
    "properties": {
     "rng_catalog": {
      "const": "f4-technical-v5"
     }
    }
   }
  },
  {
   "$comment": "Y al revés: el v5 solo lo publica un evento que amplifica.",
   "if": {
    "properties": {
     "rng_catalog": {
      "const": "f4-technical-v5"
     }
    },
    "required": [
     "rng_catalog"
    ]
   },
   "then": {
    "properties": {
     "artifacts": {
      "properties": {
       "pcr": {
        "required": [
         "applicable"
        ],
        "properties": {
         "applicable": {
          "const": true
         }
        }
       }
      },
      "required": [
       "pcr"
      ]
     }
    },
    "required": [
     "artifacts"
    ]
   }
  },
  {
   "$comment": "La sección de tartamudeo exige un catálogo con esa etapa y la versión 3 del documento.",
   "if": {
    "properties": {
     "artifacts": {
      "required": [
       "stutter"
      ]
     }
    },
    "required": [
     "artifacts"
    ]
   },
   "then": {
    "properties": {
     "rng_catalog": {
      "enum": [
       "f4-technical-v4",
       "f4-technical-v5"
      ]
     }
    }
   }
  },
  {
   "$comment": "El v4 sigue significando exactamente tartamudeo sin amplificación.",
   "if": {
    "properties": {
     "rng_catalog": {
      "const": "f4-technical-v4"
     }
    },
    "required": [
     "rng_catalog"
    ]
   },
   "then": {
    "properties": {
     "artifacts": {
      "required": [
       "stutter"
      ]
     }
    },
    "required": [
     "artifacts"
    ]
   }
  }
 ],
 "$defs": {
  "id_catalog": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "derivations"
   ],
   "properties": {
    "version": {
     "const": "3"
    },
    "derivations": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "v1",
      "v2"
     ],
     "properties": {
      "v1": {
       "const": [
        "execution",
        "reference",
        "individual",
        "event",
        "batch",
        "library",
        "read_group",
        "template"
       ]
      },
      "v2": {
       "const": [
        "PreHopInstanceId",
        "TechnicalPairId"
       ]
      }
     }
    }
   }
  },
  "id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
  },
  "digest": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "relative_path": {
   "type": "string",
   "pattern": "^(?!INCOMPLETE$)(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\/$).+$"
  },
  "checksum": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "algorithm",
    "digest"
   ],
   "properties": {
    "algorithm": {
     "const": "sha256"
    },
    "digest": {
     "$ref": "#/$defs/digest"
    }
   }
  },
  "artifact": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "kind",
    "path",
    "size_bytes",
    "checksum"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/id"
    },
    "kind": {
     "$ref": "#/$defs/id"
    },
    "path": {
     "$ref": "#/$defs/relative_path"
    },
    "size_bytes": {
     "type": "integer",
     "minimum": 0
    },
    "checksum": {
     "$ref": "#/$defs/checksum"
    }
   }
  },
  "fastq_artifact": {
   "allOf": [
    {
     "$ref": "#/$defs/artifact"
    },
    {
     "properties": {
      "path": {
       "allOf": [
        {
         "$ref": "#/$defs/relative_path"
        },
        {
         "pattern": "^outputs/fastq/[A-Za-z0-9][A-Za-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._-]{0,63}_R[12]\\.fastq\\.gz$"
        }
       ]
      }
     },
     "required": [
      "path"
     ]
    }
   ]
  },
  "profile": {
   "$comment": "Los dos perfiles hermanos, cada uno con su terna cerrada. Con enum sueltos un documento podría publicar el identificador de uno con la huella del otro.",
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "id",
      "resource_path",
      "sha256",
      "preparation",
      "read_length",
      "quality"
     ],
     "properties": {
      "id": {
       "const": "gps-hiseqx-pcrfree-pe150-v1"
      },
      "read_length": {
       "type": "integer",
       "minimum": 1,
       "maximum": 150
      },
      "resource_path": {
       "const": "resources/f4/gps-hiseqx-pcrfree-pe150-v1.json"
      },
      "sha256": {
       "const": "3d8878ab920237dae03705276a26dbb0823941830d531374d35aa1c540f6deea"
      },
      "preparation": {
       "const": "pcr_free"
      },
      "quality": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "acgt_phred",
        "n_phred"
       ],
       "properties": {
        "acgt_phred": {
         "const": 40
        },
        "n_phred": {
         "const": 0
        }
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "id",
      "resource_path",
      "sha256",
      "preparation",
      "read_length",
      "quality"
     ],
     "properties": {
      "id": {
       "const": "gps-hiseqx-pcr-pe150-v1"
      },
      "read_length": {
       "type": "integer",
       "minimum": 1,
       "maximum": 150
      },
      "resource_path": {
       "const": "resources/f4/gps-hiseqx-pcr-pe150-v1.json"
      },
      "sha256": {
       "const": "83b00fb8d084df8f6aef0464fd2b0260cfefe3f89fc523b135da6bbf6595a03c"
      },
      "preparation": {
       "const": "pcr"
      },
      "quality": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "acgt_phred",
        "n_phred"
       ],
       "properties": {
        "acgt_phred": {
         "const": 40
        },
        "n_phred": {
         "const": 0
        }
       }
      }
     }
    }
   ]
  },
  "selected_individual": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "individual_id",
    "library_id",
    "read_group_id",
    "i7",
    "i5"
   ],
   "properties": {
    "individual_id": {
     "$ref": "#/$defs/id"
    },
    "library_id": {
     "$ref": "#/$defs/id"
    },
    "read_group_id": {
     "$ref": "#/$defs/id"
    },
    "i7": {
     "type": "string",
     "pattern": "^[ACGT]{8}$"
    },
    "i5": {
     "type": "string",
     "pattern": "^[ACGT]{8}$"
    }
   }
  },
  "reference": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "reference_id",
    "fasta"
   ],
   "properties": {
    "reference_id": {
     "$ref": "#/$defs/id"
    },
    "fasta": {
     "$ref": "#/$defs/artifact"
    }
   }
  },
  "coverage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "individual_id",
    "library_id",
    "target_x",
    "basic_x",
    "final_x",
    "denominator_bases",
    "n_bases"
   ],
   "properties": {
    "individual_id": {
     "$ref": "#/$defs/id"
    },
    "library_id": {
     "$ref": "#/$defs/id"
    },
    "target_x": {
     "type": "number",
     "minimum": 0
    },
    "basic_x": {
     "type": "number",
     "minimum": 0
    },
    "final_x": {
     "$ref": "#/$defs/final_coverage"
    },
    "denominator_bases": {
     "type": "integer",
     "minimum": 1
    },
    "n_bases": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "final_coverage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "own_x",
    "contaminant_x"
   ],
   "properties": {
    "own_x": {
     "type": "number",
     "minimum": 0
    },
    "contaminant_x": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "final_fastq_summary": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "individual_id",
    "library_id",
    "pair_count",
    "read_count",
    "base_count",
    "own_pair_count",
    "contaminant_pair_count",
    "own_base_count",
    "contaminant_base_count",
    "n_base_count"
   ],
   "properties": {
    "individual_id": {
     "$ref": "#/$defs/id"
    },
    "library_id": {
     "$ref": "#/$defs/id"
    },
    "pair_count": {
     "type": "integer",
     "minimum": 0
    },
    "read_count": {
     "type": "integer",
     "minimum": 0
    },
    "base_count": {
     "type": "integer",
     "minimum": 0
    },
    "own_pair_count": {
     "type": "integer",
     "minimum": 0
    },
    "contaminant_pair_count": {
     "type": "integer",
     "minimum": 0
    },
    "own_base_count": {
     "type": "integer",
     "minimum": 0
    },
    "contaminant_base_count": {
     "type": "integer",
     "minimum": 0
    },
    "n_base_count": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "error_quality": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "requested_mode",
    "effective_mode",
    "qualities_represent_realized_error_probability",
    "r1",
    "r2"
   ],
   "properties": {
    "requested_mode": {
     "enum": [
      "enabled",
      "disabled"
     ]
    },
    "effective_mode": {
     "enum": [
      "enabled",
      "disabled"
     ]
    },
    "qualities_represent_realized_error_probability": {
     "type": "boolean"
    },
    "r1": {
     "$ref": "#/$defs/error_quality_mate"
    },
    "r2": {
     "$ref": "#/$defs/error_quality_mate"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "effective_mode": {
        "const": "enabled"
       }
      },
      "required": [
       "effective_mode"
      ]
     },
     "then": {
      "properties": {
       "requested_mode": {
        "const": "enabled"
       },
       "qualities_represent_realized_error_probability": {
        "const": true
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "effective_mode": {
        "const": "disabled"
       }
      },
      "required": [
       "effective_mode"
      ]
     },
     "then": {
      "properties": {
       "requested_mode": {
        "const": "disabled"
       },
       "qualities_represent_realized_error_probability": {
        "const": false
       },
       "r1": {
        "properties": {
         "errors": {
          "const": 0
         }
        }
       },
       "r2": {
        "properties": {
         "errors": {
          "const": 0
         }
        }
       }
      }
     }
    }
   ]
  },
  "error_quality_mate": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "quality_shift",
    "error_scale",
    "opportunities",
    "errors"
   ],
   "properties": {
    "quality_shift": {
     "const": 0
    },
    "error_scale": {
     "const": 1
    },
    "opportunities": {
     "type": "integer",
     "minimum": 0
    },
    "errors": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "demultiplexing": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "index_hopping_rate",
    "reassigned_pairs",
    "discarded_pairs",
    "unassigned_pairs",
    "reassigned_by_sample",
    "discarded_by_sample",
    "unassigned_by_sample",
    "clean_fastq_published",
    "individual_provenance_published"
   ],
   "properties": {
    "index_hopping_rate": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "reassigned_pairs": {
     "type": "integer",
     "minimum": 0
    },
    "discarded_pairs": {
     "type": "integer",
     "minimum": 0
    },
    "unassigned_pairs": {
     "type": "integer",
     "minimum": 0
    },
    "reassigned_by_sample": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/demultiplexing_reassignment"
     }
    },
    "discarded_by_sample": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/demultiplexing_discard"
     }
    },
    "unassigned_by_sample": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/demultiplexing_discard"
     }
    },
    "clean_fastq_published": {
     "const": false
    },
    "individual_provenance_published": {
     "const": false
    }
   }
  },
  "demultiplexing_reassignment": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source_library_id",
    "destination_library_id",
    "cause",
    "pair_count"
   ],
   "properties": {
    "source_library_id": {
     "$ref": "#/$defs/id"
    },
    "destination_library_id": {
     "$ref": "#/$defs/id"
    },
    "cause": {
     "const": "index_hopping"
    },
    "pair_count": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "demultiplexing_discard": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source_library_id",
    "cause",
    "pair_count"
   ],
   "properties": {
    "source_library_id": {
     "$ref": "#/$defs/id"
    },
    "cause": {
     "const": "unrecognized_udi"
    },
    "pair_count": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "technical_artifacts": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "chimera",
    "biological_contamination",
    "pcr",
    "optical_duplicates",
    "gc",
    "adapters"
   ],
   "properties": {
    "chimera": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "rate",
      "realized_pairs"
     ],
     "properties": {
      "rate": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "realized_pairs": {
       "type": "integer",
       "minimum": 0
      }
     },
     "allOf": [
      {
       "if": {
        "properties": {
         "rate": {
          "const": 0
         }
        },
        "required": [
         "rate"
        ]
       },
       "then": {
        "properties": {
         "realized_pairs": {
          "const": 0
         }
        }
       }
      }
     ]
    },
    "biological_contamination": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/biological_contamination_recipient"
     }
    },
    "pcr": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "applicable"
       ],
       "properties": {
        "applicable": {
         "const": false
        }
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "applicable",
        "algorithm",
        "rng_catalog",
        "cycles",
        "efficiency",
        "early_cycles",
        "declared_duplicate_fraction",
        "expected_duplicate_fraction",
        "mean_pairs_per_molecule",
        "duplicate_fraction_inversion",
        "max_family_size",
        "gc_max_attempts",
        "gc_relative_efficiency",
        "efficiency_classes",
        "families",
        "pairs",
        "duplicate_pairs",
        "realized_duplicate_fraction",
        "family_size_histogram",
        "families_truncated_at_end",
        "gc_attempts_total",
        "gc_attempts_exhausted_families",
        "unique_molecule_coverage_x",
        "resource_bound"
       ],
       "properties": {
        "applicable": {
         "const": true
        },
        "algorithm": {
         "const": "pcr-amplification-v1"
        },
        "rng_catalog": {
         "const": "f4-technical-v5"
        },
        "cycles": {
         "type": "integer",
         "minimum": 1,
         "maximum": 30
        },
        "efficiency": {
         "type": "number",
         "exclusiveMinimum": 0,
         "maximum": 1
        },
        "early_cycles": {
         "type": "integer",
         "minimum": 0,
         "maximum": 6
        },
        "declared_duplicate_fraction": {
         "type": "number",
         "minimum": 0,
         "exclusiveMaximum": 1
        },
        "expected_duplicate_fraction": {
         "type": "number",
         "minimum": 0,
         "exclusiveMaximum": 1
        },
        "mean_pairs_per_molecule": {
         "type": "number",
         "minimum": 0,
         "maximum": 64
        },
        "duplicate_fraction_inversion": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "method",
          "iterations"
         ],
         "properties": {
          "method": {
           "const": "bisection-64-fixed-v1"
          },
          "iterations": {
           "type": "integer",
           "minimum": 0,
           "maximum": 64
          }
         }
        },
        "max_family_size": {
         "type": "integer",
         "minimum": 1,
         "maximum": 256
        },
        "gc_max_attempts": {
         "type": "integer",
         "minimum": 1,
         "maximum": 16
        },
        "gc_relative_efficiency": {
         "type": "array",
         "minItems": 2,
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "gc_fraction",
           "relative_efficiency"
          ],
          "properties": {
           "gc_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
           },
           "relative_efficiency": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
           }
          }
         }
        },
        "efficiency_classes": {
         "type": "array",
         "minItems": 1,
         "maxItems": 4,
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "efficiency",
           "weight"
          ],
          "properties": {
           "efficiency": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
           },
           "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
           }
          }
         },
         "description": "Cuando se declaran clases de eficiencia, la eficiencia escalar de arriba DEJA DE INTERVENIR en el modelo: cada familia usa la de su clase. La escalar sigue siendo obligatoria y se publica, pero quien declare eficiencia 0,9 y clases 0,95 y 0,5 verá publicado un 0,9 que no cambia nada."
        },
        "families": {
         "type": "integer",
         "minimum": 0
        },
        "pairs": {
         "type": "integer",
         "minimum": 0
        },
        "duplicate_pairs": {
         "type": "integer",
         "minimum": 0
        },
        "realized_duplicate_fraction": {
         "type": "number",
         "minimum": 0,
         "exclusiveMaximum": 1
        },
        "family_size_histogram": {
         "type": "array",
         "description": "Familias por tamaño REALMENTE emitido. La suma ponderada por el tamaño vale exactamente el número de parejas, que es lo que impide que una celda cuente familias en vez de parejas.",
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "family_size",
           "families"
          ],
          "properties": {
           "family_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
           },
           "families": {
            "type": "integer",
            "minimum": 1
           }
          }
         }
        },
        "families_truncated_at_end": {
         "type": "integer",
         "minimum": 0
        },
        "gc_attempts_total": {
         "type": "integer",
         "minimum": 0
        },
        "gc_attempts_exhausted_families": {
         "type": "integer",
         "minimum": 0
        },
        "unique_molecule_coverage_x": {
         "type": "number",
         "minimum": 0
        },
        "resource_bound": {
         "type": "object",
         "additionalProperties": false,
         "description": "Cota PUBLICADA, no impuesta, y CALCULADA sin ejecutar: la fase de secuenciación nunca ha tenido control de recursos, de modo que imponer aquí un rechazo estrenaría algo que no le corresponde.",
         "required": [
          "operation_units",
          "memory_bytes",
          "regeneration_passes",
          "measured"
         ],
         "properties": {
          "operation_units": {
           "type": "integer",
           "minimum": 0
          },
          "memory_bytes": {
           "type": "integer",
           "minimum": 0
          },
          "regeneration_passes": {
           "const": 2
          },
          "measured": {
           "const": false
          }
         }
        }
       }
      }
     ]
    },
    "optical_duplicates": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "realized_pairs"
     ],
     "properties": {
      "realized_pairs": {
       "const": 0
      }
     }
    },
    "gc": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "mode"
     ],
     "properties": {
      "mode": {
       "enum": [
        "neutral",
        "curve"
       ]
      }
     }
    },
    "adapters": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "enabled"
     ],
     "properties": {
      "enabled": {
       "const": false
      }
     },
     "$comment": "sin adaptadores en el perfil vigente"
    },
    "stutter": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "enabled",
      "algorithm",
      "rng_catalog",
      "calibration",
      "motif_length_rates",
      "run_length_coefficient",
      "step_weights",
      "locus_parameters",
      "evaluated_tracts",
      "stuttered_tracts",
      "steps_by_locus"
     ],
     "properties": {
      "enabled": {
       "const": true
      },
      "algorithm": {
       "const": "stutter-v1"
      },
      "rng_catalog": {
       "const": "f4-technical-v4"
      },
      "calibration": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "source",
        "species",
        "technology",
        "column",
        "known_mismatch"
       ],
       "properties": {
        "source": {
         "type": "string",
         "minLength": 1
        },
        "species": {
         "const": "human"
        },
        "technology": {
         "const": "illumina"
        },
        "column": {
         "const": "pcr_free"
        },
        "known_mismatch": {
         "type": "string",
         "minLength": 1
        }
       }
      },
      "motif_length_rates": {
       "type": "array",
       "minItems": 6,
       "maxItems": 6,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "motif_length_bases",
         "rate"
        ],
        "properties": {
         "motif_length_bases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
         },
         "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         }
        }
       }
      },
      "run_length_coefficient": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "value",
        "calibrated"
       ],
       "properties": {
        "value": {
         "type": "number",
         "minimum": 0
        },
        "calibrated": {
         "const": false
        }
       }
      },
      "step_weights": {
       "type": "array",
       "minItems": 4,
       "maxItems": 4,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "units",
         "weight"
        ],
        "properties": {
         "units": {
          "enum": [
           -3,
           -2,
           -1,
           1
          ]
         },
         "weight": {
          "type": "number",
          "minimum": 0
         }
        }
       }
      },
      "locus_parameters": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "locus_id",
         "base_rates",
         "rate_substituted"
        ],
        "properties": {
         "locus_id": {
          "$ref": "#/$defs/id"
         },
         "rate_substituted": {
          "type": "boolean"
         },
         "base_rates": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "motif_length_bases",
            "rate"
           ],
           "properties": {
            "motif_length_bases": {
             "type": "integer",
             "minimum": 1,
             "maximum": 6
            },
            "rate": {
             "type": "number",
             "minimum": 0,
             "maximum": 1
            }
           }
          }
         }
        }
       }
      },
      "evaluated_tracts": {
       "type": "integer",
       "minimum": 0,
       "description": "Tractos evaluados: pares de molécula y tracto declarado que llegaron al ensayo de Bernoulli. Se cuentan por tracto y no por molécula, a propósito: es lo que hace que la suma de steps_by_locus valga exactamente stuttered_tracts, y no solo al menos. Las moléculas que se cuentan son las MUESTREADAS, no las parejas publicadas: con contaminación biológica los dos conjuntos dejan de coincidir, porque una receptora retira parejas propias y publica parejas de una donante bajo su propia biblioteca. Es la misma convención que ya usa el recuento de quimeras."
      },
      "stuttered_tracts": {
       "type": "integer",
       "minimum": 0,
       "description": "Tractos que resbalaron, con la misma convención que evaluated_tracts."
      },
      "steps_by_locus": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "locus_id",
         "steps"
        ],
        "properties": {
         "locus_id": {
          "$ref": "#/$defs/id"
         },
         "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "units",
            "count"
           ],
           "properties": {
            "units": {
             "enum": [
              -3,
              -2,
              -1,
              1
             ]
            },
            "count": {
             "type": "integer",
             "minimum": 1
            }
           }
          }
         }
        }
       }
      }
     }
    }
   },
   "allOf": [
    {
     "$comment": "El modo curve solo existe con amplificación: publicarlo sin ella afirmaría un sesgo por composición que nadie aplicó.",
     "if": {
      "properties": {
       "gc": {
        "properties": {
         "mode": {
          "const": "curve"
         }
        }
       }
      },
      "required": [
       "gc"
      ]
     },
     "then": {
      "properties": {
       "pcr": {
        "required": [
         "applicable"
        ],
        "properties": {
         "applicable": {
          "const": true
         }
        }
       }
      }
     }
    }
   ]
  },
  "biological_contamination_recipient": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "recipient_id",
    "recipient_library_id",
    "percent_range",
    "sampled_percent",
    "clean_pair_count",
    "target_pair_count",
    "removed_own_pair_count",
    "inserted_contaminant_pair_count",
    "retained_own_pair_count",
    "final_pair_count",
    "subseeds",
    "donor_contributions"
   ],
   "properties": {
    "recipient_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "recipient_library_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "percent_range": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "minimum",
      "maximum"
     ],
     "properties": {
      "minimum": {
       "type": "number",
       "minimum": 0,
       "maximum": 100
      },
      "maximum": {
       "type": "number",
       "minimum": 0,
       "maximum": 100
      }
     }
    },
    "sampled_percent": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    },
    "clean_pair_count": {
     "type": "integer",
     "minimum": 0
    },
    "target_pair_count": {
     "type": "integer",
     "minimum": 0
    },
    "removed_own_pair_count": {
     "type": "integer",
     "minimum": 0
    },
    "inserted_contaminant_pair_count": {
     "type": "integer",
     "minimum": 0
    },
    "retained_own_pair_count": {
     "type": "integer",
     "minimum": 0
    },
    "final_pair_count": {
     "type": "integer",
     "minimum": 0
    },
    "subseeds": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "percent",
      "donors",
      "removal"
     ],
     "properties": {
      "percent": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "donors": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "removal": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      }
     }
    },
    "donor_contributions": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "individual_id",
       "pairs"
      ],
      "properties": {
       "individual_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
       },
       "pairs": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    }
   }
  },
