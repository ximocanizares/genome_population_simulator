  "event_artifact": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "kind",
    "state",
    "individual_id",
    "library_id",
    "mate",
    "artifact",
    "diagnostic_code"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/id"
    },
    "kind": {
     "const": "fastq"
    },
    "state": {
     "enum": [
      "incomplete",
      "complete",
      "failed"
     ]
    },
    "individual_id": {
     "$ref": "#/$defs/id"
    },
    "library_id": {
     "$ref": "#/$defs/id"
    },
    "mate": {
     "enum": [
      1,
      2
     ]
    },
    "artifact": {
     "oneOf": [
      {
       "$ref": "#/$defs/artifact"
      },
      {
       "type": "null"
      }
     ]
    },
    "diagnostic_code": {
     "oneOf": [
      {
       "$ref": "#/$defs/diagnostic_code"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "state": {
        "const": "complete"
       },
       "mate": {
        "const": 1
       }
      },
      "required": [
       "state",
       "mate"
      ]
     },
     "then": {
      "properties": {
       "artifact": {
        "allOf": [
         {
          "$ref": "#/$defs/fastq_artifact"
         },
         {
          "properties": {
           "path": {
            "pattern": "_R1\\.fastq\\.gz$"
           }
          }
         }
        ]
       },
       "diagnostic_code": {
        "type": "null"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "state": {
        "const": "complete"
       },
       "mate": {
        "const": 2
       }
      },
      "required": [
       "state",
       "mate"
      ]
     },
     "then": {
      "properties": {
       "artifact": {
        "allOf": [
         {
          "$ref": "#/$defs/fastq_artifact"
         },
         {
          "properties": {
           "path": {
            "pattern": "_R2\\.fastq\\.gz$"
           }
          }
         }
        ]
       },
       "diagnostic_code": {
        "type": "null"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "state": {
        "enum": [
         "incomplete",
         "failed"
        ]
       }
      },
      "required": [
       "state"
      ]
     },
     "then": {
      "properties": {
       "artifact": {
        "type": "null"
       },
       "diagnostic_code": {
        "$ref": "#/$defs/diagnostic_code"
       }
      }
     }
    }
   ]
  }
 }
