{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-coordinate-map-v2.schema.json",
  "title": "Mapa de coordenadas entre dos versiones de una referencia v2",
  "description": "Extiende la forma del mapa de reducción v1 a una segunda operación, la inserción de tractos. La clase de segmento 'inserted' no lleva intervalo de origen porque sus bases no proceden del genoma de partida. SOBRE LA NUMERACIÓN: este es el primer esquema con este nombre y empieza en la versión 2 a propósito, porque HEREDA la numeración de reference-reduction-map-v1, del que es la generalización. No existe ni existirá un reference-coordinate-map-v1; quien busque la versión 1 de esta familia tiene que mirar el mapa de reducción.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_kind", "schema_version", "operation", "source_reference_id", "derived_reference_id", "segments"],
  "properties": {
    "document_kind": {
      "const": "reference_coordinate_map"
    },
    "schema_version": {
      "const": "2"
    },
    "operation": {
      "enum": ["tract_insertion"]
    },
    "source_reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "derived_reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["materialization_order", "segment_class", "sequence_id", "sequence_class", "derived_interval", "orientation"],
        "properties": {
          "materialization_order": {
            "type": "integer",
            "minimum": 1
          },
          "segment_class": {
            "enum": ["retained", "inserted"]
          },
          "sequence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "sequence_class": {
            "enum": ["chromosome", "scaffold"]
          },
          "source_interval": {
            "$ref": "#/$defs/closed_interval_1"
          },
          "derived_interval": {
            "$ref": "#/$defs/closed_interval_1"
          },
          "orientation": {
            "const": "forward"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "segment_class": {
                  "const": "retained"
                }
              },
              "required": ["segment_class"]
            },
            "then": {
              "required": ["source_interval"]
            }
          },
          {
            "if": {
              "properties": {
                "segment_class": {
                  "const": "inserted"
                }
              },
              "required": ["segment_class"]
            },
            "then": {
              "not": {
                "required": ["source_interval"]
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "closed_interval_1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
