{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "config-f5-scenario-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["config_kind", "schema_version", "scenario_id", "founder_count", "f5", "subpopulations"],
  "properties": {
    "config_kind": {"const":"f5_scenario"}, "schema_version":{"const":"1"}, "scenario_id":{"$ref":"#/$defs/id"}, "founder_count":{"type":"integer","minimum":1,"maximum":18446744073709551615},
    "f5":{"$ref":"#/$defs/f5"}, "subpopulations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/subpopulation"}}, "sampling_overrides":{"type":"array","items":{"$ref":"#/$defs/override"}}
  },
  "$defs": {
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}, "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "path":{"type":"string","pattern":"^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
    "f5":{"type":"object","additionalProperties":false,"required":["profile_metadata_path","profile_metadata_sha256"],"properties":{"profile_metadata_path":{"$ref":"#/$defs/path"},"profile_metadata_sha256":{"$ref":"#/$defs/sha"},"excluded_regions_path":{"$ref":"#/$defs/path"},"excluded_regions_sha256":{"$ref":"#/$defs/sha"},"inbreeding_f":{"type":"number","minimum":0,"maximum":1},"max_layout_attempts":{"type":"integer","minimum":1,"maximum":100000},"max_haplotype_attempts":{"type":"integer","minimum":1,"maximum":10000},"max_swap_proposals":{"type":"integer","minimum":1,"maximum":10000000},"max_haplotype_cells":{"type":"integer","minimum":1,"maximum":67108864},"max_operation_units":{"type":"integer","minimum":1,"maximum":4294967296},"max_working_memory_bytes":{"type":"integer","minimum":1,"maximum":8589934592},"max_output_bytes":{"type":"integer","minimum":1,"maximum":2147483648},"block_count":{"type":"integer","minimum":1,"maximum":4294967295},"covered_bases":{"type":"integer","minimum":1,"maximum":18446744073709551615},"coverage_fraction":{"type":"number","exclusiveMinimum":0,"maximum":1}},"allOf":[{"oneOf":[{"required":["block_count"]},{"required":["covered_bases"]},{"required":["coverage_fraction"]}]},{"not":{"anyOf":[{"required":["block_count","covered_bases"]},{"required":["block_count","coverage_fraction"]},{"required":["covered_bases","coverage_fraction"]}]}},{"if":{"required":["excluded_regions_path"]},"then":{"required":["excluded_regions_sha256"]}},{"if":{"required":["excluded_regions_sha256"]},"then":{"required":["excluded_regions_path"]}}]},
    "subpopulation":{"type":"object","additionalProperties":false,"required":["population_id","individual_count"],"properties":{"population_id":{"$ref":"#/$defs/id"},"individual_count":{"type":"integer","minimum":1,"maximum":18446744073709551615},"sampling":{"enum":["probabilistic","controlled"]},"inbreeding_f":{"type":"number","minimum":0,"maximum":1},"founder_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"founder_keys":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}},"oneOf":[{"required":["founder_ids"]},{"required":["founder_keys"]}]},
    "override":{"type":"object","additionalProperties":false,"required":["population_id","block_index","mode"],"properties":{"population_id":{"$ref":"#/$defs/id"},"block_index":{"type":"integer","minimum":0,"maximum":4294967295},"mode":{"enum":["probabilistic","controlled"]},"controlled_max_abs_error":{"type":"number","minimum":0,"maximum":1}},"allOf":[{"if":{"properties":{"mode":{"const":"probabilistic"}},"required":["mode"]},"then":{"not":{"required":["controlled_max_abs_error"]}}}]}
