{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repeat-catalog-metadata-v1.schema.json",
  "title": "Metadato del catálogo de microsatélites v1",
  "description": "Acompaña a repeat_catalog.tsv (una fila por locus del catálogo final: locus_id, sequence_id, start, end, motif, score, origin; base uno y cerrada). Lleva la referencia final y la huella de su FASTA, la huella de la tabla, la versión del algoritmo, los criterios, los recuentos del barrido por longitud de motivo y adónde fue cada tramo aceptado, los tramos que sustituye un locus declarado y los retirados por una variante (REQ-MAN-98, DTC-104). Las sumas las exige el juez del catálogo, no este esquema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind",
    "schema_version",
    "coordinate_system",
    "algorithm_version",
    "reference",
    "table",
    "criteria",
    "counts_by_motif_length",
    "replaced_tracts",
    "retired_tracts"
  ],
  "properties": {
    "document_kind": {
      "const": "repeat_catalog_metadata"
    },
    "schema_version": {
      "const": "1"
    },
    "coordinate_system": {
      "const": "base1_closed"
    },
    "algorithm_version": {
      "const": "ssr-detection-v1"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "fasta_sha256"
      ],
      "properties": {
        "reference_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "fasta_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "repeat_catalog.tsv"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_copies",
        "min_purity",
        "min_longest_run_units",
        "max_units",
        "regions"
      ],
      "properties": {
        "min_copies": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "min_purity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_longest_run_units": {
          "type": "integer",
          "minimum": 1
        },
        "max_units": {
          "type": "integer",
          "minimum": 1
        },
        "regions": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sequence_id",
                  "start",
                  "end"
                ],
                "properties": {
                  "sequence_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "counts_by_motif_length": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "motif_length",
          "detector_intervals",
          "discarded",
          "accepted",
          "replaced_by_declared",
          "retired_by_variant",
          "without_haplotype_copies",
          "published"
        ],
        "properties": {
          "motif_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "detector_intervals": {
            "type": "integer",
            "minimum": 0
          },
          "discarded": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "non_canonical_motif",
              "min_copies",
              "min_purity",
              "min_longest_run",
              "max_units",
              "edge",
              "outside_regions",
              "overlap"
            ],
            "properties": {
              "non_canonical_motif": {
                "type": "integer",
                "minimum": 0
              },
              "min_copies": {
                "type": "integer",
                "minimum": 0
              },
              "min_purity": {
                "type": "integer",
                "minimum": 0
              },
              "min_longest_run": {
                "type": "integer",
                "minimum": 0
              },
              "max_units": {
                "type": "integer",
                "minimum": 0
              },
              "edge": {
                "type": "integer",
                "minimum": 0
              },
              "outside_regions": {
                "type": "integer",
                "minimum": 0
              },
              "overlap": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "accepted": {
            "type": "integer",
            "minimum": 0
          },
          "replaced_by_declared": {
            "type": "integer",
            "minimum": 0
          },
          "retired_by_variant": {
            "type": "integer",
            "minimum": 0
          },
          "without_haplotype_copies": {
            "type": "integer",
            "minimum": 0
          },
          "published": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "replaced_tracts": {
      "type": "array",
      "description": "Tramos aceptados por la detección que un locus declarado sustituye (REQ-REF-40).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence_id",
          "start",
          "end",
          "motif",
          "score"
        ],
        "properties": {
          "sequence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "motif": {
            "type": "string",
            "pattern": "^[ACGT]{1,6}$"
          },
          "score": {
            "type": "integer"
          }
        }
      }
    },
    "retired_tracts": {
      "type": "array",
      "description": "Loci detectados que una variante pequeña retiró del catálogo (REQ-CONF-143), con su causa y la variante.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locus_id",
          "sequence_id",
          "start",
          "end",
          "motif",
          "score",
          "cause",
          "variant"
        ],
        "properties": {
          "locus_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "sequence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "motif": {
            "type": "string",
            "pattern": "^[ACGT]{1,6}$"
          },
          "score": {
            "type": "integer"
          },
          "cause": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "id",
              "position"
            ],
            "properties": {
              "source": {
                "enum": [
                  "direct_event",
                  "population_snvs"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
